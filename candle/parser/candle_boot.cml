(*
  Candle REPL startup, generated by gen_candle_boot.sh from the parser
  sources and candle_glue.cml.
*)
local

(*
  Parser locations and list helpers, ported from HOL's location theory and
  CakeML's lexer_fun.
*)
structure CandleLocation = struct
  datatype locn = Posn int int | Unknownpt | Eofpt;
  datatype locs = Locs locn locn;
end;

structure CandleSupport = struct
  open CandleLocation;
  val unknown_loc = Locs Unknownpt Unknownpt;
  val init_loc = Posn 0 0;
  fun next_loc n loc =
    case loc of Posn r c => Posn r (c + n) | _ => loc;
  fun next_line loc =
    case loc of Posn r c => Posn (r + 1) 0 | _ => loc;
  fun locnle a b =
    case (a,b) of
      (Unknownpt,_) => True
    | (_,Eofpt) => True
    | (Eofpt,_) => False
    | (_,Unknownpt) => False
    | (Posn r c,Posn s d) => r < s orelse (r = s andalso c <= d);
  fun locsle a b =
    case (a,b) of (Locs p q,Locs r s) => locnle p r;
  fun merge_locs a b =
    case (a,b) of (Locs p q,Locs r s) => Locs p s;
  fun merge_list_locs xs =
    case xs of
      [] => unknown_loc
    | h::rest =>
        let fun last acc ys =
          case ys of [] => acc | y::tl => last y tl
        in merge_locs h (last h rest) end;
  fun nsub a b = if a < b then 0 else a - b;
  fun member x xs = List.exists (fn y => x = y) xs;
  fun char_in chars c = Char.contains chars c;
  fun prefix xs ys =
    case xs of
      [] => True
    | x::xt =>
        (case ys of [] => False | y::yt => x = y andalso prefix xt yt);
  fun take n xs =
    let fun loop k ys acc =
      if k <= 0 then List.rev acc else
      case ys of [] => List.rev acc | h::tl => loop (k - 1) tl (h::acc)
    in loop n xs [] end;
  fun drop n xs =
    if n <= 0 then xs else
    case xs of [] => [] | _::tl => drop (n - 1) tl;
  fun take_while p xs =
    let fun loop ys acc =
      case ys of
        [] => (List.rev acc,ys)
      | h::tl => if p h then loop tl (h::acc) else (List.rev acc,ys)
    in loop xs [] end;
  fun hex_digit c =
    let val n = Char.ord c in
      if 48 <= n andalso n <= 57 then n - 48 else
      if 65 <= n andalso n <= 70 then n - 55 else
      if 97 <= n andalso n <= 102 then n - 87 else 0
    end;
  fun isHexDigit c = Char.isDigit c orelse char_in "ABCDEFabcdef" c;
  fun isOctDigit c = 48 <= Char.ord c andalso Char.ord c <= 55;
  fun isBinDigit c = c = #"0" orelse c = #"1";
  fun from_digits base cs =
    List.foldl (fn c => fn n => n * base + (hex_digit c) mod base) 0 cs;
end;

(*
  Token vocabulary and reserved spellings of Candle's syntax.
*)
structure CandleTokens = struct
  datatype token
    (* keywords: *)
    = AndT | AsT | AssertT | AsrT | BeginT | ClassT | ConstraintT | DoT | DoneT
    | DowntoT | ElseT | EndT | ExceptionT | ExternalT | FalseT | ForT | FunT
    | FunctionT | FunctorT | IfT | InT | IncludeT | InheritT | InitializerT
    | LandT | LazyT | LetT | LorT | LslT | LsrT | LxorT | MatchT | MethodT
    | ModT | ModuleT | MutableT | NewT | NonrecT | ObjectT | OfT | OpenT | OrT
    | PrivateT | RecT | SigT | StructT | ThenT | ToT | TrueT | TryT | TypeT
    | ValT | VirtualT | WhenT | WhileT | WithT
    (* symbol keywords: *)
    | EqualT | TickT | LparT | RparT | HashT | StarT | PlusT | CommaT | MinusT
    | LessT | GreaterT | LbrackT | RbrackT | LbraceT | RbraceT | QuestionT
    | SemiT | SemisT | BarT | OrelseT | AmpT | AndalsoT | NeqT | MinusFT
    | RarrowT | LarrowT | DotT | DotsT | EscapeT | ColonT | ColonsT | UpdateT
    | SealT | AnyT | BtickT | TildeT | LqbraceT | RqbraceT | LqbrackT
    | RqbrackT | RrbrackT | LlbrackT | RlbrackT
    (* special HOL Light tokens (all infixes): *)
    | FuncompT | F_FT
    | THEN_T | THENC_T | THENL_T | THEN_TCL_T
    | ORELSE_T | ORELSEC_T | ORELSE_TCL_T
    (* CakeML pragma *)
    | PragmaT string
    (* literals and identifiers: *)
    | IntT int
    | FloatT string
    | CharT char
    | StringT string
    | IdentT string
    | SymbolT string    (* symbols *)
    | LexErrorT;
  val keywords = [
    ("", LexErrorT),
    ("=", EqualT),
    ("'", TickT),
    ("(", LparT),
    (")", RparT),
    ("#", HashT),
    ("*", StarT),
    ("+", PlusT),
    (",", CommaT),
    ("-", MinusT),
    ("<", LessT),
    (">", GreaterT),
    ("[", LbrackT),
    ("]", RbrackT),
    ("{", LbraceT),
    ("}", RbraceT),
    ("?", QuestionT),
    (";", SemiT),
    (";;", SemisT),
    ("|", BarT),
    ("||", OrelseT),
    ("&", AmpT),
    ("&&", AndalsoT),
    ("!=", NeqT),
    ("-.", MinusFT),
    ("->", RarrowT),
    ("<-", LarrowT),
    (".", DotT),
    ("..", DotsT),
    (".~", EscapeT),
    (":", ColonT),
    ("::", ColonsT),
    (":=", UpdateT),
    (":>", SealT),
    ("_", AnyT),
    ("`", BtickT),
    ("~", TildeT),
    ("{<", LqbraceT),
    (">}", RqbraceT),
    ("[<", LqbrackT),
    (">]", RqbrackT),
    ("[>", RrbrackT),
    ("[|", LlbrackT),
    ("|]", RlbrackT),
    ("and", AndT),
    ("as", AsT),
    ("assert", AssertT),
    ("asr", AsrT),
    ("begin", BeginT),
    ("class", ClassT),
    ("constraint", ConstraintT),
    ("do", DoT),
    ("done", DoneT),
    ("downto", DowntoT),
    ("else", ElseT),
    ("end", EndT),
    ("exception", ExceptionT),
    ("external", ExternalT),
    ("false", FalseT),
    ("for", ForT),
    ("fun", FunT),
    ("function", FunctionT),
    ("functor", FunctorT),
    ("if", IfT),
    ("in", InT),
    ("include", IncludeT),
    ("inherit", InheritT),
    ("initializer", InitializerT),
    ("land", LandT),
    ("lazy", LazyT),
    ("let", LetT),
    ("lor", LorT),
    ("lsl", LslT),
    ("lsr", LsrT),
    ("lxor", LxorT),
    ("match", MatchT),
    ("method", MethodT),
    ("mod", ModT),
    ("module", ModuleT),
    ("mutable", MutableT),
    ("new", NewT),
    ("nonrec", NonrecT),
    ("object", ObjectT),
    ("of", OfT),
    ("open", OpenT),
    ("or", OrT),
    ("private", PrivateT),
    ("rec", RecT),
    ("sig", SigT),
    ("struct", StructT),
    ("then", ThenT),
    ("to", ToT),
    ("true", TrueT),
    ("try", TryT),
    ("type", TypeT),
    ("val", ValT),
    ("virtual", VirtualT),
    ("when", WhenT),
    ("while", WhileT),
    ("with", WithT),
    ("o", FuncompT),
    ("F_F", F_FT),
    ("THEN", THEN_T),
    ("THENC", THENC_T),
    ("THENL", THENL_T),
    ("THEN_TCL", THEN_TCL_T),
    ("ORELSE", ORELSE_T),
    ("ORELSEC", ORELSEC_T),
    ("ORELSE_TCL", ORELSE_TCL_T)
  ];
  fun get_token s =
    if s = "" then LexErrorT else
    case Alist.lookup keywords s of
      Some t => t
    | None =>
        let val c = String.sub s 0 in
          if Char.isAlpha c orelse c = #"_" then IdentT s else SymbolT s
        end;
end;

(*
  The lexer for Candle's syntax.
*)
structure CandleLexer = struct
  open CandleSupport;
  open CandleTokens;
  datatype symbol = NumberS int | FloatS (char list) | StringS (char list)
                  | CharS char | OtherS (char list) | PragmaS (char list) | ErrorS;

  fun skip_comment cs depth loc =
    case cs of
      x::y::xs =>
        if x = #"(" andalso y = #"*" then
          skip_comment xs (depth + 1) (next_loc 2 loc)
        else if x = #"*" andalso y = #")" then
          if depth = 0 then Some (xs,next_loc 2 loc)
          else skip_comment xs (depth - 1) (next_loc 2 loc)
        else if x = #"\n" then skip_comment (y::xs) depth (next_line loc)
        else skip_comment (y::xs) depth (next_loc 1 loc)
    | _ => None;

  fun scan_escseq cs loc =
    case cs of
      #"\\"::rest =>
        (case rest of
          #"\\"::tl => Some (#"\\",tl,next_loc 2 loc)
        | #"\""::tl => Some (#"\"",tl,next_loc 2 loc)
        | #"'"::tl => Some (#"'",tl,next_loc 2 loc)
        | #"n"::tl => Some (#"\n",tl,next_loc 2 loc)
        | #"r"::tl => Some (#"\r",tl,next_loc 2 loc)
        | #"t"::tl => Some (#"\t",tl,next_loc 2 loc)
        | #"b"::tl => Some (#"\b",tl,next_loc 2 loc)
        | #" "::tl => Some (#" ",tl,next_loc 2 loc)
        | #"x"::a::b::tl =>
            if isHexDigit a andalso isHexDigit b then
              Some (Char.chr (from_digits 16 [a,b]),tl,next_loc 4 loc)
            else None
        | #"o"::a::b::c::tl =>
            if 48 <= Char.ord a andalso Char.ord a <= 51 andalso
               isOctDigit b andalso isOctDigit c then
              Some (Char.chr (from_digits 8 [a,b,c]),tl,next_loc 5 loc)
            else None
        | a::b::c::tl =>
            if List.all Char.isDigit [a,b,c] then
              let val n = from_digits 10 [a,b,c] in
                if n <= 255 then Some (Char.chr n,tl,next_loc 4 loc) else None
              end
            else None
        | _ => None)
    | _ => None;

  fun scan_strlit acc cs loc =
    case cs of
      [] => Some (ErrorS,CandleLocation.Locs loc loc,cs)
    | #"\""::tl => Some (StringS (List.rev acc),CandleLocation.Locs loc loc,tl)
    | #"\n"::tl => scan_strlit (#"\n"::acc) tl (next_line loc)
    | #"\\"::_ =>
        (case scan_escseq cs loc of
          None => Some (ErrorS,CandleLocation.Locs loc loc,cs)
        | Some (c,tl,loc2) => scan_strlit (c::acc) tl loc2)
    | c::tl => scan_strlit (c::acc) tl (next_loc 1 loc);

  fun scan_charlit cs loc =
    case cs of
      [] => Some (ErrorS,CandleLocation.Locs loc loc,cs)
    | #"\\"::_ =>
        (case scan_escseq cs loc of
          Some (c,rest,loc2) =>
            (case rest of
              #"'"::tl => Some (CharS c,CandleLocation.Locs loc loc2,tl)
            | _ => Some (ErrorS,CandleLocation.Locs loc loc2,rest))
        | None => Some (ErrorS,CandleLocation.Locs loc loc,cs))
    | c :: #"'" :: rest => Some (CharS c,CandleLocation.Locs loc (next_loc 1 loc),rest)
    | _ => Some (ErrorS,CandleLocation.Locs loc loc,cs);

  fun scan_number ok_digit to_int offset cs loc =
    case cs of
      [] => Some (ErrorS,CandleLocation.Locs loc loc,cs)
    | h::_ =>
        if not (ok_digit h) then Some (ErrorS,CandleLocation.Locs loc loc,cs) else
        let
          val (digits,rest) = take_while (fn c => c = #"_" orelse ok_digit c) cs;
          val clean = List.filter (fn c => c <> #"_") digits;
          val (suffix,rest2) = case rest of
              c::tl => if char_in "lLn" c then (1,tl) else (0,rest)
            | [] => (0,rest);
        in Some (NumberS (to_int clean),
                 CandleLocation.Locs loc (next_loc (nsub (List.length digits + offset + suffix) 1) loc),
                 rest2)
        end;

  fun scan_float1 cs =
    case cs of
      [] => None
    | c::_ => if not (Char.isDigit c) then None else
        let val (digits,rest) = take_while (fn c => c = #"_" orelse Char.isDigit c) cs
        in Some (List.filter (fn c => c <> #"_") digits,List.length digits,rest) end;

  fun scan_float2 cs =
    case cs of
      #"."::tl =>
        let val (digits,rest) = take_while (fn c => c = #"_" orelse Char.isDigit c) tl
        in Some (#"."::List.filter (fn c => c <> #"_") digits,List.length digits + 1,rest) end
    | _ => None;

  fun scan_float3 cs =
    case cs of
      x::y::rest =>
        if not (char_in "eE" x) then None else
        if char_in "+-" y then
          (case rest of
            [] => None
          | c::_ => if not (Char.isDigit c) then None else
              let val (digits,rest2) = take_while (fn c => c = #"_" orelse Char.isDigit c) rest
              in Some (x::y::List.filter (fn c => c <> #"_") digits,2 + List.length digits,rest2) end)
        else if not (Char.isDigit y) then None else
          let val (digits,rest2) = take_while (fn c => c = #"_" orelse Char.isDigit c) rest
          in Some (x::y::List.filter (fn c => c <> #"_") digits,2 + List.length digits,rest2) end
    | _ => None;

  fun scan_float_or_int cs loc =
    case scan_float1 cs of
      None => Some (ErrorS,CandleLocation.Locs loc loc,cs)
    | Some (s1,n1,cs1) =>
        (case scan_float2 cs1 of
          None =>
            (case scan_float3 cs1 of
              None => scan_number Char.isDigit (from_digits 10) 0 cs loc
            | Some (s2,n2,cs2) => Some (FloatS (s1 @ s2),CandleLocation.Locs loc (next_loc (n1 + n2) loc),cs2))
        | Some (s2,n2,cs2) =>
            (case scan_float3 cs2 of
              None => Some (FloatS (s1 @ s2),CandleLocation.Locs loc (next_loc (n1 + n2) loc),cs2)
            | Some (s3,n3,cs3) => Some (FloatS (s1 @ s2 @ s3),
                CandleLocation.Locs loc (next_loc (n1 + n2 + n3) loc),cs3)));

  fun scan_pragma level n cs loc =
    case cs of
      x::y::xs =>
        if x = #"(" andalso y = #"*" then
          scan_pragma (level + 1) (n + 2) xs (next_loc 2 loc)
        else if x = #"*" andalso y = #")" then
          if level = 0 then Some (n,next_loc 2 loc,xs)
          else scan_pragma (level - 1) (n + 2) xs (next_loc 2 loc)
        else if x = #"\n" then scan_pragma level (n + 1) (y::xs) (next_line loc)
        else scan_pragma level (n + 1) (y::xs) (next_loc 1 loc)
    | _ => None;

  fun next_sym input loc =
    case input of
      [] => None
    | c::cs =>
        if c = #"\n" then next_sym cs (next_line loc) else
        if Char.isSpace c then next_sym cs (next_loc 1 loc) else
        if Char.isDigit c then
          (case (c,cs) of
            (#"0",h::tl) =>
              if h = #"x" orelse h = #"X" then scan_number isHexDigit (from_digits 16) 2 tl loc else
              if h = #"o" orelse h = #"O" then scan_number isOctDigit (from_digits 8) 2 tl loc else
              if h = #"b" orelse h = #"B" then scan_number isBinDigit (from_digits 2) 2 tl loc else
              scan_float_or_int input loc
          | _ => scan_float_or_int input loc)
        else if c = #"\"" then scan_strlit [] cs (next_loc 1 loc)
        else if c = #"'" then
          (case scan_charlit cs (next_loc 1 loc) of
            None => Some (OtherS [c],CandleLocation.Locs loc loc,cs)
          | Some (ErrorS,_,_) => Some (OtherS [c],CandleLocation.Locs loc loc,cs)
          | Some res => Some res)
        else if prefix [#"*",#")"] input then
          Some (ErrorS,CandleLocation.Locs loc (next_loc 2 loc),drop 1 cs)
        else if prefix [#"(",#"*",#"C",#"M",#"L"] input then
          (case scan_pragma 0 0 (drop 4 cs) loc of
            None => Some (ErrorS,CandleLocation.Locs loc loc,[])
          | Some (n,loc2,rest) => Some (PragmaS (take n (drop 4 cs)),CandleLocation.Locs loc loc2,rest))
        else if prefix [#"(",#"*"] input then
          (case skip_comment (drop 1 cs) 0 (next_loc 2 loc) of
            None => Some (ErrorS,CandleLocation.Locs loc (next_loc 2 loc),[])
          | Some (rest,loc2) => next_sym rest loc2)
        else if char_in "()[]{}," c then Some (OtherS [c],CandleLocation.Locs loc loc,cs)
        else if char_in "#$&*+-/=>@^|~!?%<:.;" c then
          let val (s,rest) = take_while (char_in "#$&*+-/=>@^|~!?%<:.;") input
          in Some (OtherS s,CandleLocation.Locs loc (next_loc (nsub (List.length s) 1) loc),rest) end
        else if Char.isAlpha c orelse c = #"_" then
          let val (s,rest) = take_while (fn c => Char.isAlphaNum c orelse char_in "'_" c) input
          in Some (OtherS s,CandleLocation.Locs loc (next_loc (nsub (List.length s) 1) loc),rest) end
        else Some (ErrorS,CandleLocation.Locs loc loc,cs);

  fun sym2token sym =
    case sym of
      NumberS i => IntT i
    | FloatS s => FloatT (String.implode s)
    | StringS s => StringT (String.implode s)
    | CharS c => CharT c
    | OtherS s => get_token (String.implode s)
    | PragmaS s => PragmaT (String.implode s)
    | ErrorS => LexErrorT;

  fun next_token cs loc =
    case next_sym cs loc of
      None => None
    | Some (sym,locs,rest) => Some (sym2token sym,locs,rest);

  fun lexer_fun_aux cs loc =
    case next_token cs loc of
      None => []
    | Some (tok,CandleLocation.Locs start finish,rest) =>
        (tok,CandleLocation.Locs start finish)::lexer_fun_aux rest (next_loc 1 finish);

  fun lexer_fun cs = lexer_fun_aux cs init_loc;
  fun lex input = lexer_fun (String.explode input);
end;

(*
  PEG execution, ported from pegexec.coreloop. The continuation machine keeps
  backtracking, error-stack order and list-tail sharing as in the reference.
*)
structure CandlePeg = struct
  datatype ('a,'b,'c,'e) symbol =
      Empty 'c | Any ('a * CandleLocation.locs -> 'c)
    | Tok ('a -> bool) ('a * CandleLocation.locs -> 'c)
    | Nt 'b ('c -> 'c)
    | Seq (('a,'b,'c,'e) symbol) (('a,'b,'c,'e) symbol) ('c -> 'c -> 'c)
    | Choice (('a,'b,'c,'e) symbol) (('a,'b,'c,'e) symbol) (('c,'c) sum -> 'c)
    | Rpt (('a,'b,'c,'e) symbol) ('c list -> 'c)
    | Not (('a,'b,'c,'e) symbol) 'c | Error 'e;
  datatype ('a,'b,'c,'e) kont =
      Ksym (('a,'b,'c,'e) symbol) (('a,'b,'c,'e) kont) (('a,'b,'c,'e) kont)
    | Appf1 ('c -> 'c) (('a,'b,'c,'e) kont)
    | Appf2 ('c -> 'c -> 'c) (('a,'b,'c,'e) kont)
    | DropErr (('a,'b,'c,'e) kont)
    | AddErr CandleLocation.locs 'e (('a,'b,'c,'e) kont)
    | CmpErrs (('a,'b,'c,'e) kont)
    | CmpEO ((CandleLocation.locs * 'e) option) (('a,'b,'c,'e) kont)
    | ReturnTo (('a * CandleLocation.locs) list) ('c option list) (('a,'b,'c,'e) kont)
    | RestoreEO ((CandleLocation.locs * 'e) option) (('a,'b,'c,'e) kont)
    | Poplist ('c list -> 'c) (('a,'b,'c,'e) kont)
    | Listsym (('a,'b,'c,'e) symbol) ('c list -> 'c) (('a,'b,'c,'e) kont)
    | Done | Failed;
  datatype ('a,'c,'e) result = Success 'a 'c ((CandleLocation.locs * 'e) option)
                           | Failure CandleLocation.locs 'e;
  datatype ('a,'b,'c,'e) state =
      EV (('a,'b,'c,'e) symbol) (('a * CandleLocation.locs) list) ('c option list)
         ((CandleLocation.locs * 'e) option) ((CandleLocation.locs * 'e) list)
         (('a,'b,'c,'e) kont) (('a,'b,'c,'e) kont)
    | AP (('a,'b,'c,'e) kont) (('a * CandleLocation.locs) list) ('c option list)
         ((CandleLocation.locs * 'e) option) ((CandleLocation.locs * 'e) list)
    | Result ((('a * CandleLocation.locs) list,'c,'e) result) | Looped;

  val eof = CandleLocation.Locs CandleLocation.Eofpt CandleLocation.Eofpt;
  fun sloc input = case input of [] => eof | (_,l)::_ => l;
  fun maxerr (l1,e1) (l2,e2) =
    if CandleSupport.locsle l1 l2 then (l2,e2) else (l1,e1);
  fun ome x y = case (x,y) of
      (None,_) => y | (_,None) => x | (Some a,Some b) => Some (maxerr a b);
  fun poplist_aux acc r = case r of
      Some h::t => poplist_aux (h::acc) t
    | None::t => (acc,t) | [] => (acc,[]);
  fun poplistval f r =
    let val (values,rest) = poplist_aux [] r in Some (f values)::rest end;

  fun coreloop (rules,anyEOF,tokFALSE,tokEOF,notFAIL) state =
    let
      fun loop state = case state of
        EV (Empty v) i r eo errs k fk => loop (AP k i (Some v::r) eo errs)
      | EV (Any tf) i r eo errs k fk =>
          (case i of
            [] => let val err = (eof,anyEOF)
                  in loop (AP fk i r (ome eo (Some err)) (err::errs)) end
          | h::t => loop (AP k t (Some (tf h)::r) eo errs))
      | EV (Tok p tf) i r eo errs k fk =>
          (case i of
            [] => let val err = (eof,tokEOF)
                  in loop (AP fk i r (ome eo (Some err)) (err::errs)) end
          | (token,l)::t => if p token then loop (AP k t (Some (tf (token,l))::r) eo errs)
                    else let val err = (sloc i,tokFALSE)
                         in loop (AP fk i r (ome eo (Some err)) (err::errs)) end)
      | EV (Nt n tf) i r eo errs k fk =>
          (case rules n of None => Looped
           | Some e => loop (EV e i r eo errs (Appf1 tf k) fk))
      | EV (Seq e1 e2 f) i r eo errs k fk =>
          loop (EV e1 i r eo errs
            (RestoreEO eo (Ksym e2 (Appf2 f k) (CmpEO eo (ReturnTo i r fk)))) fk)
      | EV (Choice e1 e2 cf) i r eo errs k fk =>
          loop (EV e1 i r eo errs (Appf1 (fn v => cf (Inl v)) k)
            (ReturnTo i r (Ksym e2 (DropErr (Appf1 (fn v => cf (Inr v)) k)) (CmpErrs fk))))
      | EV (Rpt e lf) i r eo errs k fk =>
          loop (EV e i (None::r) eo errs (RestoreEO eo (Listsym e lf k)) (Poplist lf k))
      | EV (Not e v) i r eo errs k fk =>
          loop (EV e i r eo errs
            (RestoreEO eo (ReturnTo i r (AddErr (sloc i) notFAIL fk)))
            (RestoreEO eo (ReturnTo i (Some v::r) (DropErr k))))
      | EV (Error e) i r eo errs k fk =>
          let val err = (sloc i,e)
          in loop (AP fk i r (ome eo (Some err)) (err::errs)) end
      | AP Done i (Some v::_) eo errs => Result (Success i v eo)
      | AP Failed i r eo ((l,e)::_) => Result (Failure l e)
      | AP (DropErr k) i r eo (_::t) => loop (AP k i r eo t)
      | AP (AddErr l e k) i r eo errs =>
          loop (AP k i r (ome eo (Some (l,e))) ((l,e)::errs))
      | AP (CmpErrs k) i r eo (e2::e1::rest) => loop (AP k i r eo (maxerr e1 e2::rest))
      | AP (CmpEO eo1 k) i r eo2 (err::rest) =>
          loop (AP k i r (ome eo1 (Some err)) (err::rest))
      | AP (Ksym e k fk) i r eo errs => loop (EV e i r eo errs k fk)
      | AP (Appf1 f k) i (Some v::r) eo errs => loop (AP k i (Some (f v)::r) eo errs)
      | AP (Appf2 f k) i (Some v1::Some v2::r) eo errs =>
          loop (AP k i (Some (f v2 v1)::r) eo errs)
      | AP (ReturnTo i r k) oldi oldr eo errs => loop (AP k i r eo errs)
      | AP (RestoreEO eo k) i r oldeo errs => loop (AP k i r eo errs)
      | AP (Listsym e f k) i r eo errs =>
          loop (EV e i r eo errs (RestoreEO eo (Listsym e f k)) (Poplist f k))
      | AP (Poplist f k) i r eo (_::errs) => loop (AP k i (poplistval f r) eo errs)
      | Result r => Result r
      | _ => Looped;
    in loop state end;

  fun execute grammar sym input = coreloop grammar (EV sym input [] None [] Done Failed);
end;

(*
  Parse trees from grammar.ptree, restricted to token leaves: the executable
  grammar never builds a nonterminal leaf. Node labels have the
  ('b,int) sum shape of grammar.ptree's nonterminals.
*)
structure CandleTree = struct
  datatype ('a,'b) tree = Lf ('a * CandleLocation.locs)
    | Nd ((('b,int) sum) * CandleLocation.locs) (('a,'b) tree list);
  fun loc tree = case tree of Lf (_,l) => l | Nd (_,l) _ => l;
  fun list_loc trees = CandleSupport.merge_list_locs (List.map loc trees);
  fun mkNd nt children = Nd (nt,list_loc children) children;
  fun fringe tree = case tree of
      Lf (t,l) => [(t,l)]
    | Nd _ children => List.concat (List.map fringe children);
end;

(*
  Grammar-building helpers for the PEG rule table, with native string
  predicates.
*)
structure CandleGrammarSupport = struct
  open CandleTokens;
  open CandleTree;
  fun identity x = x;
  fun append a b = a @ b;
  fun foldl f acc xs = List.foldl (fn x => fn a => f a x) acc xs;
  fun sumID x = case x of Inl a => a | Inr b => b;
  fun mktokLf t = [Lf t];
  fun bindNT n l = [mkNd (Inl n) l];
  fun mk_linfix tgt acc rest = case rest of
      opt::t::tl => mk_linfix tgt (mkNd tgt [acc,opt,t]) tl
    | _ => acc;
  fun empty v = CandlePeg.Empty v;
  fun tok p f = CandlePeg.Tok p f;
  fun seq a b f = CandlePeg.Seq a b f;
  fun rpt e f = CandlePeg.Rpt e f;
  fun pnt n = CandlePeg.Nt (Inl n) identity;
  fun choicel xs = case xs of
      [] => CandlePeg.Not (empty []) []
    | h::t => CandlePeg.Choice h (choicel t) sumID;
  fun pegf sym f = seq sym (empty []) (fn a => fn b => f a);
  fun seql xs f = pegf
    (List.foldr (fn p => fn acc => seq p acc append) (empty []) xs) f;
  fun try sym = choicel [sym,empty []];
  fun peg_linfix tgt rptsym opsym =
    seq rptsym (rpt (seq opsym rptsym append) List.concat)
      (fn a => fn b => case a of
         [] => [] | h::_ => [mk_linfix tgt (mkNd tgt [h]) b]);
  fun tokeq t = tok (fn x => x = t) mktokLf;
  fun tokSymP p = tok (fn t => case t of SymbolT s => p s | _ => False) mktokLf;
  fun tokIdP p = tok (fn t => case t of IdentT s => p s | _ => False) mktokLf;
  fun tokPragma u = tok (fn t => case t of PragmaT s => True | _ => False) mktokLf;
  fun isInt t = case t of IntT _ => True | _ => False;
  fun isString t = case t of StringT _ => True | _ => False;
  fun isChar t = case t of CharT _ => True | _ => False;
  fun isIdent t = case t of IdentT _ => True | _ => False;
  fun validCoreOpChar c = Char.contains "$&*+-/=>@^|" c;
  fun validOpChar c = Char.contains "!?%<:." c orelse validCoreOpChar c;
  fun opName first s = case String.explode s of
      [] => False | h::t => first h t andalso List.all validOpChar t;
  fun validPrefixSym s = opName (fn h => fn t =>
    h = #"!" orelse h = #"?" orelse (h = #"~" andalso t <> [])) s;
  fun validInfixSym s = opName (fn h => fn t =>
    validCoreOpChar h orelse h = #"%" orelse h = #"<" orelse
    (h = #"#" andalso t <> [])) s;
  fun validMultOp s = s = "%" orelse s = "/" orelse
    opName (fn h => fn t => Char.contains "*%/" h andalso t <> []) s;
  fun validAddOp s = opName (fn h => fn t => Char.contains "+-" h andalso t <> []) s;
  fun validRelOp s = opName (fn h => fn t => Char.contains "=<>|&$" h andalso t <> []) s;
  fun validShiftOp s = case String.explode s of
      #"*" :: #"*" :: t => List.all validOpChar t | _ => False;
  fun validCatOp s = opName (fn h => fn t => h = #"@" orelse Char.ord h = 94) s;
  fun idChar p cs = List.all (fn c => p c orelse c = #"_" orelse c = #"'" orelse Char.isDigit c) cs;
  fun identUpperLower s = case String.explode s of [] => False
    | h::t => Char.isUpper h andalso idChar Char.isLower t andalso List.exists Char.isLower t;
  fun identMixed s = case String.explode s of [] => False
    | h::t => idChar Char.isAlpha t andalso
        (Char.isLower h orelse h = #"_" orelse
         (Char.isUpper h andalso (not (List.exists Char.isAlpha t) orelse List.exists Char.isUpper t)));
  fun identLower s = case String.explode s of [] => False
    | h::t => (Char.isLower h orelse h = #"_") andalso idChar Char.isAlpha t;
end;

(*
  The PEG rule table of Candle's grammar, one rule per nonterminal NFoo.
  Choices are tried in the order listed.
*)
structure CandleGrammar = struct
  open CandleGrammarSupport;
  datatype nonterm =
      NEHolInfix | NHolInfixOp | NValuePath | NValueName | NConstr
    | NConstrName | NTypeConstr | NTypeConstrName | NModulePath | NModuleName
    | NModTypePath | NModTypeName | NFieldName | NOperatorName | NLiteral
    | NIdent | NEBase | NEList | NEApp | NEConstr | NEFunapp | NEAssert
    | NELazy | NEPrefix | NEIndex | NENeg | NEShift | NEMult | NERecProj
    | NERecUpdate | NERecCons | NEAdd | NECons | NECat | NERel | NEAnd | NEOr
    | NEProd | NEAssign | NEIf | NESeq | NEMatch | NETry | NEFun | NEFunction
    | NELet | NELetRec | NEWhile | NEFor | NExpr | NEUnclosed | NArrIdx
    | NStrIdx | NUpdate | NUpdates | NFieldDec | NFieldDecs | NLetBinding
    | NLetBindings | NLetRecBinding | NLetRecBindings | NPatternMatch
    | NPatternMatches | NTypeDefinition | NTypeDef | NTypeDefs | NTypeParams
    | NTypeInfo | NTypeRepr | NTypeReprs | NConstrDecl | NConstrArgs | NRecord
    | NExcDefinition | NPAny | NPList | NPPar | NPBase | NPRecFields | NPCons
    | NPAs | NPOps | NPattern | NPatterns | NTypeList | NTypeLists | NTVar
    | NTBase | NTConstr | NTProd | NTFun | NType | NSigSpec | NSigItems
    | NSigItem | NModTypeAssign | NModTypeAsc | NModAscApp | NModAscApps
    | NValType | NExcType | NModuleTypeDef | NIncludeMod | NOpenMod
    | NDefinition | NTopLet | NTopLetRec | NModuleItem | NModuleItems | NOpen
    | NModExpr | NModuleDef | NModuleType | NSemis | NExprItem | NExprItems
    | NDefItem | NShiftOp | NMultOp | NAddOp | NRelOp | NAndOp | NOrOp
    | NCatOp | NPrefixOp | NAssignOp | NPatLiteral | NStart | NCakeMLPragma;
  type rule = (CandleTokens.token,(nonterm,int) sum,
    (CandleTokens.token,nonterm) CandleTree.tree list,string) CandlePeg.symbol;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NCakeMLPragma u : rule =
       pegf (tokPragma ()) (bindNT NCakeMLPragma);
  fun rule_NHolInfixOp u : rule =
       pegf (choicel [tokeq FuncompT, tokeq F_FT, tokeq THEN_T, tokeq THENC_T,
                      tokeq THENL_T, tokeq THEN_TCL_T, tokeq ORELSE_T,
                      tokeq ORELSEC_T, tokeq ORELSE_TCL_T])
            (bindNT NHolInfixOp);
  fun rule_NValueName u : rule =
       choicel [pegf (tokIdP (identMixed)) (bindNT NValueName),
                seql [tokeq LparT, pnt NOperatorName, tokeq RparT]
                     (bindNT NValueName)];
  fun rule_NOperatorName u : rule =
       pegf (choicel [pnt NShiftOp,
                      pnt NMultOp,
                      pnt NAddOp,
                      pnt NRelOp,
                      pnt NAndOp,
                      pnt NOrOp,
                      pnt NHolInfixOp,
                      pnt NCatOp,
                      pnt NPrefixOp,
                      pnt NAssignOp ])
            (bindNT NOperatorName);
  fun rule_NConstrName u : rule =
       pegf (tokIdP (identUpperLower)) (bindNT NConstrName);
  fun rule_NTypeConstrName u : rule =
       pegf (tokIdP (identLower)) (bindNT NTypeConstrName);
  fun rule_NModuleName u : rule =
       pegf (tokIdP (identUpperLower)) (bindNT NModuleName);
  fun rule_NFieldName u : rule =
       pegf (tokIdP (identLower)) (bindNT NFieldName);
  fun rule_NValuePath u : rule =
       seql [try (seql [pnt NModulePath, tokeq DotT] identity), pnt NValueName]
            (bindNT NValuePath);
  fun rule_NConstr u : rule =
       pegf (choicel [seql [pnt NModuleName, tokeq DotT, pnt NConstr] identity,
                      pnt NConstrName])
            (bindNT NConstr);
  fun rule_NTypeConstr u : rule =
       seql [try (seql [pnt NModulePath, tokeq DotT] identity), pnt NTypeConstrName]
            (bindNT NTypeConstr);
  fun rule_NModulePath u : rule =
       seql [pnt NModuleName, try (seql [tokeq DotT, pnt NModulePath] identity)]
            (bindNT NModulePath);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NCakeMLPragma,rule_NCakeMLPragma ()),
(Inl NHolInfixOp,rule_NHolInfixOp ()),
(Inl NValueName,rule_NValueName ()),
(Inl NOperatorName,rule_NOperatorName ()),
(Inl NConstrName,rule_NConstrName ()),
(Inl NTypeConstrName,rule_NTypeConstrName ()),
(Inl NModuleName,rule_NModuleName ()),
(Inl NFieldName,rule_NFieldName ()),
(Inl NValuePath,rule_NValuePath ()),
(Inl NConstr,rule_NConstr ()),
(Inl NTypeConstr,rule_NTypeConstr ()),
(Inl NModulePath,rule_NModulePath ())
  ];
  in
  fun chunk_0 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NModTypeName u : rule =
       pegf (tokIdP (fn x => True)) (bindNT NModTypeName);
  fun rule_NModTypePath u : rule =
       pegf (choicel [seql [pnt NModuleName, tokeq DotT, pnt NModTypePath] identity,
                      pnt NModTypeName])
            (bindNT NModTypePath);
  fun rule_NSemis u : rule =
       seql [tokeq SemisT, try (pnt NSemis)]
            (bindNT NSemis);
  fun rule_NExprItems u : rule =
       seql [try (pnt NSemis), pnt NExpr]
            (bindNT NExprItems);
  fun rule_NExprItem u : rule =
       seql [pnt NSemis, pnt NExpr]
            (bindNT NExprItem);
  fun rule_NDefItem u : rule =
       seql [try (pnt NSemis), pnt NDefinition]
            (bindNT NDefItem);
  fun rule_NModuleItems u : rule =
       seql [choicel [pnt NExprItems, pnt NDefItem],
             try (pnt NModuleItem),
             try (pnt NSemis)]
            (bindNT NModuleItems);
  fun rule_NModuleItem u : rule =
       seql [choicel [pnt NExprItem, pnt NDefItem],
             try (pnt NModuleItem)]
            (bindNT NModuleItem);
  fun rule_NTopLet u : rule =
       seql [tokeq LetT, pnt NLetBindings]
            (bindNT NTopLet);
  fun rule_NTopLetRec u : rule =
       seql [tokeq LetT, tokeq RecT, pnt NLetRecBindings]
            (bindNT NTopLetRec);
  fun rule_NOpen u : rule =
       seql [tokeq OpenT, pnt NModulePath]
            (bindNT NOpen);
  fun rule_NModExpr u : rule =
       pegf (choicel [pnt NModulePath,
                      seql [tokeq StructT, try (pnt NModuleItems), tokeq EndT] identity])
            (bindNT NModExpr);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NModTypeName,rule_NModTypeName ()),
(Inl NModTypePath,rule_NModTypePath ()),
(Inl NSemis,rule_NSemis ()),
(Inl NExprItems,rule_NExprItems ()),
(Inl NExprItem,rule_NExprItem ()),
(Inl NDefItem,rule_NDefItem ()),
(Inl NModuleItems,rule_NModuleItems ()),
(Inl NModuleItem,rule_NModuleItem ()),
(Inl NTopLet,rule_NTopLet ()),
(Inl NTopLetRec,rule_NTopLetRec ()),
(Inl NOpen,rule_NOpen ()),
(Inl NModExpr,rule_NModExpr ())
  ];
  in
  fun chunk_1 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NModuleDef u : rule =
       seql [tokeq ModuleT, pnt NModuleName,
             try (seql [tokeq ColonT, pnt NModuleType] identity),
             tokeq EqualT, pnt NModExpr]
            (bindNT NModuleDef);
  fun rule_NDefinition u : rule =
       pegf (choicel [pnt NTopLetRec,
                      pnt NTopLet,
                      pnt NTypeDefinition,
                      pnt NExcDefinition,
                      pnt NOpen,
                      pnt NModuleTypeDef,
                      pnt NModuleDef,

                      pnt NCakeMLPragma])
            (bindNT NDefinition);
  fun rule_NExcType u : rule =
       seql [tokeq ExceptionT, pnt NConstrDecl]
            (bindNT NExcType);
  fun rule_NValType u : rule =
       seql [tokeq ValT, pnt NValueName, tokeq ColonT, pnt NType]
            (bindNT NValType);
  fun rule_NModAscApp u : rule =
       seql [tokeq LparT, pnt NModuleName, tokeq ColonT,
             pnt NModuleType, tokeq RparT]
            (bindNT NModAscApp);
  fun rule_NModAscApps u : rule =
       seql [pnt NModAscApp, try (pnt NModAscApps)]
            (bindNT NModAscApps);
  fun rule_NModTypeAsc u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModuleName,
             try (pnt NModAscApps),
             tokeq ColonT, pnt NModuleType]
            (bindNT NModTypeAsc);
  fun rule_NModTypeAssign u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModTypeName,
             try (seql [tokeq EqualT, pnt NModuleType] identity)]
            (bindNT NModTypeAssign);
  fun rule_NOpenMod u : rule =
       seql [tokeq OpenT, pnt NModulePath]
            (bindNT NOpenMod);
  fun rule_NIncludeMod u : rule =
       seql [tokeq IncludeT, pnt NModulePath]
            (bindNT NIncludeMod);
  fun rule_NSigItem u : rule =
       pegf (choicel [pnt NTypeDefinition,
                      pnt NExcType,
                      pnt NValType,
                      pnt NModTypeAsc,
                      pnt NModTypeAssign,
                      pnt NOpenMod,
                      pnt NIncludeMod])
            (bindNT NSigItem);
  fun rule_NSigItems u : rule =
       seql [pnt NSigItem, try (pnt NSemis), try (pnt NSigItems)]
            (bindNT NSigItems);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NModuleDef,rule_NModuleDef ()),
(Inl NDefinition,rule_NDefinition ()),
(Inl NExcType,rule_NExcType ()),
(Inl NValType,rule_NValType ()),
(Inl NModAscApp,rule_NModAscApp ()),
(Inl NModAscApps,rule_NModAscApps ()),
(Inl NModTypeAsc,rule_NModTypeAsc ()),
(Inl NModTypeAssign,rule_NModTypeAssign ()),
(Inl NOpenMod,rule_NOpenMod ()),
(Inl NIncludeMod,rule_NIncludeMod ()),
(Inl NSigItem,rule_NSigItem ()),
(Inl NSigItems,rule_NSigItems ())
  ];
  in
  fun chunk_2 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NSigSpec u : rule =
       seql [tokeq SigT, try (pnt NSigItems), tokeq EndT]
            (bindNT NSigSpec);
  fun rule_NModuleType u : rule =
       pegf (choicel [pnt NModTypePath,
                      pnt NSigSpec,
                      seql [tokeq LparT, pnt NModuleType, tokeq RparT] identity])
            (bindNT NModuleType);
  fun rule_NModuleTypeDef u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModTypeName, tokeq EqualT,
             pnt NModuleType]
            (bindNT NModuleTypeDef);
  fun rule_NExcDefinition u : rule =
       seql [tokeq ExceptionT,
             choicel [seql [pnt NConstrName, tokeq EqualT, pnt NConstr] identity,
                      pnt NConstrDecl]]
            (bindNT NExcDefinition);
  fun rule_NTypeDefinition u : rule =
       seql [tokeq TypeT, try (tokeq NonrecT), pnt NTypeDefs]
            (bindNT NTypeDefinition);
  fun rule_NTypeDef u : rule =
       seql [try (pnt NTypeParams), pnt NTypeConstrName,
             try (pnt NTypeInfo)]
            (bindNT NTypeDef);
  fun rule_NTypeDefs u : rule =
       seql [pnt NTypeDef, try (seql [tokeq AndT, pnt NTypeDefs] identity)]
            (bindNT NTypeDefs);
  fun rule_NTypeParams u : rule =
       choicel [pegf (pnt NTVar) (bindNT NTypeParams),
                seql [tokeq LparT, pnt NTVar,
                      rpt (seql [tokeq CommaT, pnt NTVar] identity) List.concat,
                      tokeq RparT]
                     (bindNT NTypeParams)];
  fun rule_NTypeInfo u : rule =
       seql [tokeq EqualT,
             choicel [pnt NType, pnt NTypeRepr]]
            (bindNT NTypeInfo);
  fun rule_NTypeRepr u : rule =
       seql [try (tokeq BarT), pnt NConstrDecl, try (pnt NTypeReprs)]
            (bindNT NTypeRepr);
  fun rule_NTypeReprs u : rule =
       seql [tokeq BarT, pnt NConstrDecl, try (pnt NTypeReprs)]
            (bindNT NTypeReprs);
  fun rule_NConstrDecl u : rule =
       seql [pnt NConstrName,
             try (seql [tokeq OfT, choicel [pnt NConstrArgs, pnt NRecord]] identity)]
            (bindNT NConstrDecl);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NSigSpec,rule_NSigSpec ()),
(Inl NModuleType,rule_NModuleType ()),
(Inl NModuleTypeDef,rule_NModuleTypeDef ()),
(Inl NExcDefinition,rule_NExcDefinition ()),
(Inl NTypeDefinition,rule_NTypeDefinition ()),
(Inl NTypeDef,rule_NTypeDef ()),
(Inl NTypeDefs,rule_NTypeDefs ()),
(Inl NTypeParams,rule_NTypeParams ()),
(Inl NTypeInfo,rule_NTypeInfo ()),
(Inl NTypeRepr,rule_NTypeRepr ()),
(Inl NTypeReprs,rule_NTypeReprs ()),
(Inl NConstrDecl,rule_NConstrDecl ())
  ];
  in
  fun chunk_3 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NRecord u : rule =
       seql [tokeq LbraceT, pnt NFieldDecs, try (tokeq SemiT), tokeq RbraceT]
            (bindNT NRecord);
  fun rule_NFieldDecs u : rule =
       seql [pnt NFieldDec, try (seql [tokeq SemiT, pnt NFieldDecs] identity)]
            (bindNT NFieldDecs);
  fun rule_NFieldDec u : rule =
       seql [pnt NFieldName, tokeq ColonT, pnt NType]
            (bindNT NFieldDec);
  fun rule_NConstrArgs u : rule =
       seql [pnt NTConstr, rpt (seql [tokeq StarT, pnt NTConstr] identity) List.concat]
            (bindNT NConstrArgs);
  fun rule_NTypeList u : rule =
       seql [pnt NType, tokeq CommaT, pnt NTypeLists]
            (bindNT NTypeList);
  fun rule_NTypeLists u : rule =
       seql [pnt NType, try (seql [tokeq CommaT, pnt NTypeLists] identity)]
            (bindNT NTypeLists);
  fun rule_NTVar u : rule =
       seql [tokeq TickT, pnt NIdent] (bindNT NTVar);
  fun rule_NTBase u : rule =
       pegf (choicel [seql [tokeq LparT, pnt NType, tokeq RparT] identity,
                      seql [tokeq LparT, pnt NTypeList, tokeq RparT,
                            pnt NTypeConstr] identity,
                      pnt NTVar])
            (bindNT NTBase);
  fun rule_NTConstr u : rule =
       choicel [seql [try (pnt NTBase), pnt NTypeConstr,
                      rpt (pnt NTypeConstr) List.concat]
                     (bindNT NTConstr),
                pegf (pnt NTBase) (bindNT NTConstr)];
  fun rule_NTProd u : rule =
       seql [pnt NTConstr, rpt (seql [tokeq StarT, pnt NTConstr] identity) List.concat]
            (bindNT NTProd);
  fun rule_NTFun u : rule =
       seql [pnt NTProd, try (seql [tokeq RarrowT, pnt NTFun] identity)]
            (bindNT NTFun);
  fun rule_NType u : rule =
       pegf (pnt NTFun) (bindNT NType);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NRecord,rule_NRecord ()),
(Inl NFieldDecs,rule_NFieldDecs ()),
(Inl NFieldDec,rule_NFieldDec ()),
(Inl NConstrArgs,rule_NConstrArgs ()),
(Inl NTypeList,rule_NTypeList ()),
(Inl NTypeLists,rule_NTypeLists ()),
(Inl NTVar,rule_NTVar ()),
(Inl NTBase,rule_NTBase ()),
(Inl NTConstr,rule_NTConstr ()),
(Inl NTProd,rule_NTProd ()),
(Inl NTFun,rule_NTFun ()),
(Inl NType,rule_NType ())
  ];
  in
  fun chunk_4 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NEList u : rule =
       seql [tokeq LbrackT,
             try (seql [pnt NEIf,
                        rpt (seql [tokeq SemiT, pnt NEIf] identity) List.concat,
                        try (tokeq SemiT)] identity),
             tokeq RbrackT]
            (bindNT NEList);
  fun rule_NLiteral u : rule =
       choicel [
         tok isInt    (fn t => bindNT NLiteral (mktokLf t)),
         tok isString (fn t => bindNT NLiteral (mktokLf t)),
         tok isChar   (fn t => bindNT NLiteral (mktokLf t)),
         tok (fn x => x = TrueT orelse x = FalseT) (fn t => bindNT NLiteral (mktokLf t))];
  fun rule_NIdent u : rule =
       tok isIdent (fn t => bindNT NIdent (mktokLf t));
  fun rule_NUpdate u : rule =
       seql [pnt NFieldName, tokeq EqualT, pnt NEIf]
            (bindNT NUpdate);
  fun rule_NUpdates u : rule =
       seql [pnt NUpdate, try (seql [tokeq SemiT, pnt NUpdates] identity)]
            (bindNT NUpdates);
  fun rule_NERecUpdate u : rule =
       seql [pnt NConstr, tokeq LbraceT, pnt NExpr, tokeq WithT, pnt NUpdates,
             try (tokeq SemiT), tokeq RbraceT]
            (bindNT NERecUpdate);
  fun rule_NEBase u : rule =
       choicel [
         pegf (pnt NLiteral) (bindNT NEBase),
         pegf (pnt NValuePath) (bindNT NEBase),

         pegf (pnt NERecUpdate) (bindNT NEBase),
         pegf (pnt NConstr) (bindNT NEBase),
         pegf (pnt NEList) (bindNT NEBase),
         seql [tokeq LparT, tokeq RparT] (bindNT NEBase),
