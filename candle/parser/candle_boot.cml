(*
  The parser front end: lexing and parsing up to, but not including, AST
  conversion.
*)
structure CandleFrontEnd = struct
  fun run_lexer input =
    let val tokens = CandleLexer.lex input;
        val errors = List.map (fn (_,l) => l)
          (List.filter (fn (t,_) => t = CandleTokens.LexErrorT) tokens);
    in case errors of [] => Inr tokens | _ => Inl errors end;
  fun destResult result = case result of
      CandlePeg.Result (CandlePeg.Success [] x eo) => CandlePeg.Success [] x eo
    | CandlePeg.Result (CandlePeg.Success ((_,l)::_) _ _) =>
        CandlePeg.Failure l "Expected to be at EOF"
    | CandlePeg.Result (CandlePeg.Failure l e) => CandlePeg.Failure l e
    | _ => CandlePeg.Failure CandleSupport.unknown_loc "Something catastrophic happened";
  fun parse_tree input = case run_lexer input of
      Inl (l::_) => Inl (l,"LEXER ERROR")
    | Inl [] => raise Fail "unreachable: empty lexer error list"
    | Inr tokens =>
        (case destResult (CandleGrammar.parse_tokens tokens) of
          CandlePeg.Failure l e => Inl (l,e)
        | CandlePeg.Success _ x _ => Inr x);
end;

(*
  Parse-tree conversion helpers. All errors are values. Choice is left-biased
  and evaluates its alternative only on failure.
*)
structure CandleConversionSupport = struct
  open CandleSupport;
  open CandleTokens;
  open CandleTree;
  (* cmlPtreeConversion.to_locs: sentinels belong to parser errors, not Ast. *)
  fun to_locs loc = case loc of
      Locs (Posn r1 c1) (Posn r2 c2) => Ast.Locs (r1,c1) (r2,c2)
    | _ => Ast.Nolocs;
  fun bind m f = case m of Inl e => Inl e | Inr x => f x;
  fun fmap f m = bind m (fn x => Inr (f x));
  fun choice m other = case m of Inl _ => other () | Inr x => Inr x;
  fun option m = case m of None => Inl (unknown_loc,"option") | Some x => Inr x;
  fun mapM f xs = case xs of [] => Inr [] | x::rest =>
    bind (f x) (fn y => bind (mapM f rest) (fn ys => Inr (y::ys)));
  fun list_cart_prod xss = case xss of [] => [[]] | xs::rest =>
    let val ys = list_cart_prod rest;
    in List.concat (List.map (fn x => List.map (fn y => x::y) ys) xs) end;
  fun compatCons cn =
    if cn = "Bad_file_name" then "BadFileName"
    else if cn = "Pp_data" then "PP_Data" else cn;
  fun compatModName mn =
    if mn = "Text_io" then "TextIO"
    else if mn = "Pretty_printer" then "PrettyPrinter"
    else if mn = "Command_line" then "CommandLine"
    else if mn = "Word8_array" then "Word8Array" else mn;
  fun destLf pt = case pt of Lf x => Inr x | Nd (_,l) _ => Inl (l,"destLf");
  fun token pt = fmap (fn (tk,_) => tk) (destLf pt);
  fun ident pt = bind (token pt) (fn tk =>
    option (case tk of IdentT s => Some s | _ => None));
  fun expect_tok pt expected = bind (destLf pt) (fn (tk,l) =>
    if tk = expected then Inr tk else Inl (l,"Unexpected token"));
  fun path_to_ns l ns = case ns of [] => Inl (l,"Empty path")
    | [n] => Inr (Ast.Short n)
    | n::rest => fmap (fn tail => Ast.Long n tail) (path_to_ns l rest);
  fun nterm_of pt = case pt of Lf (_,l) => Inl (l,"nterm_of: Not a parsetree node")
    | Nd (nt,_) _ => Inr nt;
end;

(*
  Name and operator conversion, with its error strings and compatibility
  renamings. Node checks precede child conversion.
*)
structure CandleNames = struct
  open CandleGrammar;
  open CandleConversionSupport;
  fun name nt expected impossible rename pt = case pt of
      Lf (_,l) => Inl (l,expected)
    | Nd (n,l) args => if n <> Inl nt then Inl (l,expected)
        else case args of [arg] => fmap rename (ident arg)
           | _ => Inl (l,impossible);
  fun ptree_Ident pt = name NIdent "Expected ident non-terminal"
    "Impossible: nIdent" (fn x => x) pt;
  fun ptree_ConstrName pt = name NConstrName "Expected constr-name non-terminal"
    "Impossible: nConstrName" compatCons pt;
  fun ptree_TypeConstrName pt = name NTypeConstrName "Expected typeconstr-name non-terminal"
    "Impossible: nTypeConstrName" (fn x => x) pt;
  fun ptree_FieldName pt = name NFieldName "Expected fieldname non-terminal"
    "Impossible: nFieldName" (fn x => x) pt;
  fun ptree_ModuleName pt = name NModuleName "Expected modulename non-terminal"
    "Impossible: nModuleName" compatModName pt;
  fun ptree_ModTypeName pt = name NModTypeName "Expected modtypename non-terminal"
    "Impossible: nModTypeName" (fn x => x) pt;
  fun op_name l msg allow_symbol table tk =
    case List.find (fn (t,_) => t = tk) table of
      Some (_,s) => Inr s
    | None => (case tk of SymbolT s => if allow_symbol then Inr s else Inl (l,msg)
                         | _ => Inl (l,msg));
  fun ptree_Op pt = case pt of Lf (_,l) => Inl (l,"Expected operator non-terminal")
    | Nd (n,l) args => case args of [arg] => bind (token arg) (fn tk =>
        if n = Inl NShiftOp then op_name l "Impossible: nShiftOp" True
          [(LslT,"lsl"),(LsrT,"lsr"),(AsrT,"asr")] tk
        else if n = Inl NMultOp then op_name l "Impossible: nMultOp" True
          [(StarT,"*"),(ModT,"mod"),(LandT,"land"),(LorT,"lor"),(LxorT,"lxor")] tk
        else if n = Inl NAddOp then op_name l "Impossible: nAddOp" True
          [(PlusT,"+"),(MinusT,"-"),(MinusFT,"-.")] tk
        else if n = Inl NRelOp then op_name l "Impossible: nRelOp" True
          [(LessT,"<"),(GreaterT,">"),(EqualT,"=")] tk
        else if n = Inl NAndOp then op_name l "Impossible: nAndOp" True
          [(AndalsoT,"&&"),(AmpT,"&")] tk
        else if n = Inl NOrOp then op_name l "Impossible: nOrOp" True
          [(OrelseT,"||"),(OrT,"|")] tk
        else if n = Inl NHolInfixOp then op_name l "Impossible: nHolInfixOp" False
          [(FuncompT,"o"),(F_FT,"F_F"),(THEN_T,"THEN"),(THENC_T,"THENC"),
           (THENL_T,"THENL"),(THEN_TCL_T,"THEN_TCL"),(ORELSE_T,"ORELSE"),
           (ORELSEC_T,"ORELSEC"),(ORELSE_TCL_T,"ORELSE_TCL")] tk
        else if n = Inl NCatOp then op_name l "Impossible: nCatOp" True [] tk
        else if n = Inl NPrefixOp then op_name l "Impossible: nPrefixOp" True [] tk
        else if n = Inl NAssignOp then op_name l "Impossible: nAssignOp" False
          [(LarrowT,"<-"),(UpdateT,":=")] tk
        else Inl (l,"Expected operator non-terminal"))
      | _ => Inl (l,"Expected operator non-terminal");
  fun ptree_OperatorName pt = case pt of
      Lf (_,l) => Inl (l,"Expected operator-name non-terminal")
    | Nd (n,l) args => if n <> Inl NOperatorName then Inl (l,"Expected operator-name non-terminal")
        else case args of [arg] => ptree_Op arg | _ => Inl (l,"Impossible: nOperatorName");
  fun ptree_ValueName pt = case pt of Lf (_,l) => Inl (l,"Expected value-name non-terminal")
    | Nd (n,l) args => if n <> Inl NValueName then Inl (l,"Expected value-name non-terminal")
        else case args of [arg] => ident arg
          | [lp,opn,rp] => bind (expect_tok lp LparT) (fn _ =>
              bind (expect_tok rp RparT) (fn _ => ptree_OperatorName opn))
          | _ => Inl (l,"Impossible: nValueName");
  fun ptree_ModulePath pt = case pt of Lf (_,l) => Inl (l,"Expected module-path non-terminal")
    | Nd (n,l) args => if n <> Inl NModulePath then Inl (l,"Expected module-path non-terminal")
        else case args of [arg] => fmap (fn x => [x]) (ptree_ModuleName arg)
          | [arg,dot,path] => bind (expect_tok dot DotT) (fn _ =>
              bind (ptree_ModulePath path) (fn vp =>
              fmap (fn vn => vn::vp) (ptree_ModuleName arg)))
          | _ => Inl (l,"Impossible: nModulePath");
  fun qualified nt expected impossible conv pt = case pt of
      Lf (_,l) => Inl (l,expected)
    | Nd (n,l) args => if n <> Inl nt then Inl (l,expected)
        else case args of [arg] => fmap (fn x => [x]) (conv arg)
          | [path,dot,arg] => bind (expect_tok dot DotT) (fn _ =>
              bind (ptree_ModulePath path) (fn vp => fmap (fn vn => vp @ [vn]) (conv arg)))
          | _ => Inl (l,impossible);
  fun ptree_ValuePath pt = qualified NValuePath "Expected value-path non-terminal"
    "Impossible: nValuePath" ptree_ValueName pt;
  fun ptree_TypeConstr pt = qualified NTypeConstr "Expected typeconstr non-terminal"
    "Impossible: nTypeConstr" ptree_TypeConstrName pt;
  fun ptree_Constr pt = case pt of Lf (_,l) => Inl (l,"Expected constr non-terminal")
    | Nd (n,l) args => if n <> Inl NConstr then Inl (l,"Expected constr non-terminal")
        else case args of [arg] => fmap (fn x => [x]) (ptree_ConstrName arg)
          | [name,dot,rest] => bind (expect_tok dot DotT) (fn _ =>
              bind (ptree_ModuleName name) (fn vp => fmap (fn vn => vp::vn) (ptree_Constr rest)))
          | _ => Inl (l,"Impossible: nConstr");
  fun ptree_ModTypePath pt = case pt of Lf (_,l) => Inl (l,"Expected modtypepath non-terminal")
    | Nd (n,l) args => if n <> Inl NModTypePath then Inl (l,"Expected typeconstr non-terminal")
        else case args of [arg] => fmap (fn x => [x]) (ptree_ModTypeName arg)
          | [name,dot,rest] => bind (expect_tok dot DotT) (fn _ =>
              bind (ptree_ModuleName name) (fn vm => fmap (fn vp => vm::vp) (ptree_ModTypePath rest)))
          | _ => Inl (l,"Impossible: nModTypePath");
end;

(*
  Conversion of types and literals from parse trees.
*)
structure CandleTypes = struct
  open CandleNames;
  fun ptree_TVar pt = case pt of Lf (_,l) => Inl (l,"Expected type variable non-terminal")
    | Nd (n,l) args => if n <> Inl NTVar then Inl (l,"Expected type variable non-terminal")
      else case args of [tick,id] => bind (expect_tok tick TickT) (fn _ =>
        fmap (fn v => Ast.Atvar v) (ptree_Ident id))
      | _ => Inl (l,"Impossible: nTVar");
  fun ptree_Type pt = case pt of Lf (_,l) => Inl (l,"Expected a type non-terminal")
    | Nd (n,l) args =>
      if n = Inl NType then
        (case args of [ty] => ptree_Type ty | _ => Inl (l,"Impossible: nType"))
      else if n = Inl NTBase then
        (case args of [lp,ts,rp,ctor] => bind (expect_tok lp LparT) (fn _ =>
           bind (expect_tok rp RparT) (fn _ => bind (ptree_TypeList ts) (fn tys =>
           bind (ptree_TypeConstr ctor) (fn nm =>
           fmap (fn id => Ast.Atapp tys id) (path_to_ns l nm)))))
         | [lp,arg,rp] => bind (expect_tok lp LparT) (fn _ =>
           bind (expect_tok rp RparT) (fn _ => ptree_Type arg))
         | [arg] => ptree_TVar arg
         | _ => Inl (l,"Impossible: nTBase"))
      else if n = Inl NTConstr then
        (case args of arg::rest =>
          let fun apply ty = bind (mapM ptree_TypeConstr rest) (fn ids =>
                fmap (fn cns => List.foldl (fn id => fn t => Ast.Atapp [t] id) ty cns)
                  (mapM (path_to_ns l) ids));
          in choice (bind (ptree_Type arg) apply) (fn _ =>
               bind (ptree_TypeConstr arg) (fn id =>
               bind (path_to_ns l id) (fn cn => apply (Ast.Atapp [] cn)))) end
         | _ => Inl (l,"Impossible: nTConstr"))
      else if n = Inl NTProd then
        (case args of [arg] => ptree_Type arg
         | arg::rest => bind (ptree_Type arg) (fn ty =>
             fmap (fn ts => Ast.Attup (ty::ts)) (ptree_StarTypes rest))
         | _ => Inl (l,"Impossible: nTProd"))
      else if n = Inl NTFun then
        (case args of [arg] => ptree_Type arg
         | [arg,arrow,rest] => bind (expect_tok arrow RarrowT) (fn _ =>
             bind (ptree_Type arg) (fn t1 => fmap (fn t2 => Ast.Atfun t1 t2) (ptree_Type rest)))
         | _ => Inl (l,"Impossible: nTFun"))
      else Inl (l,"Expected type non-terminal")
  and ptree_TypeList pt = case pt of Lf (_,l) => Inl (l,"Expected a type list non-terminal")
    | Nd (n,l) args =>
      if n = Inl NTypeList orelse n = Inl NTypeLists then
        (case args of [typ,comma,tlist] => bind (ptree_Type typ) (fn t =>
           bind (expect_tok comma CommaT) (fn _ =>
           fmap (fn ts => t::ts) (ptree_TypeList tlist)))
         | [typ] => if n = Inl NTypeLists then fmap (fn t => [t]) (ptree_Type typ)
                    else Inl (l,"Impossible: nTypeList")
         | _ => Inl (l,if n = Inl NTypeList then "Impossible: nTypeList"
                        else "Impossible: nTypeLists"))
      else Inl (l,"Expected a type list non-terminal")
  and ptree_StarTypes pts = case pts of [] => Inr [] | x::xs =>
    choice (bind (expect_tok x StarT) (fn _ => ptree_StarTypes xs)) (fn _ =>
      bind (ptree_Type x) (fn t => fmap (fn ts => t::ts) (ptree_StarTypes xs)));
  fun literal expected impossible convert pt = case pt of Lf (_,l) => Inl (l,expected)
    | Nd (n,l) args => if n <> Inl NLiteral then Inl (l,expected)
      else case args of [arg] => bind (token arg) (convert l)
      | _ => Inl (l,impossible);
  fun ptree_Literal pt = literal "Expected a literal non-terminal" "Impossible: nLiteral"
    (fn l => fn tk => case tk of IntT n => Inr (Ast.Intlit n)
      | CharT c => Inr (Ast.Char c) | StringT s => Inr (Ast.Strlit s)
      | _ => Inl (l,"Impossible: nLiteral")) pt;
  fun bool2id b = Ast.Short (if b then "True" else "False");
  fun ptree_Bool pt = literal "Expected a boolean literal non-terminal" "Impossible: nLiteral (bool)"
    (fn l => fn tk => if tk = TrueT orelse tk = FalseT then Inr (bool2id (tk = TrueT))
                     else Inl (l,"not a boolean literal")) pt;
  fun ptree_Double pt = literal "Expected a float literal non-terminal" "Impossible: nLiteral (float)"
    (fn l => fn tk => case tk of FloatT s => Inr (Ast.Lit (Ast.Strlit s))
                             | _ => Inl (l,"not a float literal")) pt;
end;

(*
  Operator-precedence resolution, ported from precparser's precparse1 and
  precparse.
*)
structure CandlePrecedence = struct
  datatype action = Reduce | Shift;
  fun omap f x = case x of None => None | Some y => Some (f y);
  fun step rules reduce lift isOp mkApp (stk,input) = case input of
      [] => (case stk of Inr b::Inl oper::Inr a::rest =>
               omap (fn r => (Inr r::rest,[])) (reduce a oper b)
             | _ => None)
    | tok::more => if isOp tok then
        (case stk of Inr b::Inl oper::Inr a::rest =>
          (case rules (oper,tok) of
             Some Shift => Some (Inl tok::stk,more)
           | Some Reduce => omap (fn r => (Inr r::rest,input)) (reduce a oper b)
           | None => None)
         | [Inr tm] => Some ([Inl tok,Inr tm],more)
         | _ => None)
      else (case stk of [] => Some ([Inr (lift tok)],more)
        | Inr ftm::rest => omap (fn r => (Inr r::rest,more)) (mkApp ftm (lift tok))
        | Inl _::_ => Some (Inr (lift tok)::stk,more));
  fun precparse rules reduce lift isOp mkApp state = case state of
      ([Inr tm],[]) => Some tm
    | _ => (case step rules reduce lift isOp mkApp state of None => None
          | Some next => precparse rules reduce lift isOp mkApp next);
end;

(*
  Pre-patterns, precedence resolution, compatibility currying and pattern
  conversion, including record restrictions and or-pattern distribution.
*)
structure CandlePatterns = struct
  open CandleTypes;
  datatype ppat = Pp_any | Pp_var string | Pp_lit Ast.lit
    | Pp_con ((string,string) Ast.id option) (ppat list)
    | Pp_record ((string,string) Ast.id) (string list)
    | Pp_prod (ppat list) | Pp_or ppat ppat | Pp_tannot ppat Ast.ast_t
    | Pp_alias ppat (string list) | Pp_as ppat string;
  fun ppat_to_pat pp = case pp of
      Pp_any => Inr [Ast.Pany]
    | Pp_var v => Inr [Ast.Pvar v]
    | Pp_lit l => Inr [Ast.Plit l]
    | Pp_tannot p t => fmap (List.map (fn q => Ast.Ptannot q t)) (ppat_to_pat p)
    | Pp_con id ps => bind (ppat_to_pats ps) (fn qs =>
        Inr (List.map (fn args => Ast.Pcon id args) (list_cart_prod qs)))
    | Pp_record _ _ => Inl (unknown_loc,"")
    | Pp_prod ps => bind (ppat_to_pats ps) (fn qs =>
        Inr (List.map (fn args => Ast.Pcon None args) (list_cart_prod qs)))
    | Pp_alias p ns => fmap (List.map (fn q =>
        List.foldl (fn n => fn r => Ast.Pas r n) q ns)) (ppat_to_pat p)
    | Pp_as p n => fmap (List.map (fn q => Ast.Pas q n)) (ppat_to_pat p)
    | Pp_or p q => bind (ppat_to_pat p) (fn ps =>
        fmap (fn qs => ps @ qs) (ppat_to_pat q))
  and ppat_to_pats ps = case ps of [] => Inr [] | p::rest =>
    bind (ppat_to_pat p) (fn q => fmap (fn qs => q::qs) (ppat_to_pats rest));
  fun compatCurryP id p = case id of
      Ast.Long mn vn =>
        if mn = "PrettyPrinter" andalso vn = Ast.Short "PP_Data" then
          (case p of Pp_con None ps => Pp_con (Some id) ps
                   | _ => Pp_con (Some id) [p])
        else Pp_con (Some id) [p]
    | Ast.Short nm =>
        if member nm ["Abs","Var","Const","Comb","Tyapp","Sequent","Append"] then
          (case p of Pp_any => Pp_con (Some id) [Pp_any,Pp_any]
           | Pp_con None ps => Pp_con (Some id) ps
           | _ => Pp_con (Some id) [p])
        else Pp_con (Some id) [p];
  datatype pp_op = Po_cons | Po_prod | Po_or | Po_alias;
  fun rank oper = case oper of Po_cons => 3 | Po_prod => 2 | Po_or => 1 | Po_alias => 0;
  fun tok_action pair = case pair of (Inl stk,Inl inp) =>
      if stk = Po_alias then Some CandlePrecedence.Reduce
      else if rank inp < rank stk then Some CandlePrecedence.Reduce
      else if rank stk < rank inp then Some CandlePrecedence.Shift
      else if stk = Po_cons then Some CandlePrecedence.Shift
      else Some CandlePrecedence.Reduce
    | _ => None;
  fun dest_alias pp = case pp of Pp_alias p ns => Some (p,ns) | _ => None;
  fun tok2ppo pt = bind (token pt) (fn tk => case tk of
      ColonsT => Inr Po_cons | CommaT => Inr Po_prod | BarT => Inr Po_or
    | _ => Inl (unknown_loc,"ppatOp: impossible"));
  fun ppat_close pp = case pp of Pp_prod ps => Pp_con None ps
    | Pp_alias p ns => List.foldl (fn n => fn q => Pp_as q n) p ns
    | _ => pp;
  fun ppat_reduce a oper b = case oper of
      Inl Po_or => (case (a,b) of (Inl x,Inl y) => Some (Inl (Pp_or (ppat_close x) y))
                                 | _ => None)
    | Inl Po_prod => (case (a,b) of
        (Inl (Pp_prod ps),Inl y) => Some (Inl (Pp_prod (ps @ [y])))
      | (Inl x,Inl y) => Some (Inl (Pp_prod [x,y])) | _ => None)
    | Inl Po_cons => (case (a,b) of (Inl x,Inl y) =>
        Some (Inl (Pp_con (Some (Ast.Short "::")) [ppat_close x,y])) | _ => None)
    | Inl Po_alias => (case (a,b) of (Inl x,Inr y) =>
        Some (Inl (Pp_alias (ppat_close x) y)) | _ => None)
    | _ => None;
  fun resolve_precs xs = case CandlePrecedence.precparse tok_action ppat_reduce
      (fn x => case x of Inr y => y | _ => Inr [])
      (fn x => case x of Inl _ => True | _ => False)
      (fn x => fn y => None) ([],xs) of
      Some (Inl pp) => Inr (ppat_close pp)
    | _ => Inl (unknown_loc,"resolve_precs");
  fun ptree_AsIds pts = case pts of [] => Inr []
    | [_] => Inl (unknown_loc,"Impossible: ptree_AsIds")
    | x::y::xs => bind (expect_tok x AsT) (fn _ => bind (ptree_Ident y) (fn n =>
        fmap (fn ns => n::ns) (ptree_AsIds xs)));
  fun build_list_ppat ps = List.foldr (fn t => fn p =>
      Pp_con (Some (Ast.Short "::")) [t,p]) (Pp_con (Some (Ast.Short "[]")) []) ps;
  fun ptree_FieldsList pts = case pts of
      [rb] => bind (expect_tok rb RbraceT) (fn _ => Inr [])
    | [semi,rb] => bind (expect_tok semi SemiT) (fn _ =>
        bind (expect_tok rb RbraceT) (fn _ => Inr []))
    | semi::fname::fs => bind (expect_tok semi SemiT) (fn _ =>
        bind (ptree_FieldName fname) (fn n => fmap (fn ns => n::ns) (ptree_FieldsList fs)))
    | [] => Inl (unknown_loc,"Impossible: ptree_FieldsList");
  fun ptree_PRecFields pt = case pt of
      Lf (_,l) => Inl (l,"Expected a pattern record fields non-terminal")
    | Nd (n,l) args => if n <> Inl NPRecFields then Inl (l,"Expected a pattern record fields non-terminal")
      else case args of lb::fname::rest => bind (expect_tok lb LbraceT) (fn _ =>
        bind (ptree_FieldName fname) (fn name => fmap (fn ns => name::ns) (ptree_FieldsList rest)))
      | _ => Inl (l,"Impossible: nPRecFields");
  fun constr_id l cn = bind (ptree_Constr cn) (path_to_ns l);
  fun ptree_PPattern pt = case pt of Lf (_,l) => Inl (l,"Expected a pattern non-terminal")
    | Nd (n,l) args =>
      if n = Inl NPAny then
        (case args of [arg] => bind (expect_tok arg AnyT) (fn _ => Inr Pp_any)
         | _ => Inl (l,"Impossible: nPAny"))
      else if n = Inl NPList then
        (case args of lb::rest => bind (expect_tok lb LbrackT) (fn _ =>
           fmap build_list_ppat (ptree_PPatternList rest))
         | _ => Inl (l,"Impossible: nPList"))
      else if n = Inl NPPar then
        (case args of [lp,rp] => bind (expect_tok lp LparT) (fn _ =>
           bind (expect_tok rp RparT) (fn _ => Inr (Pp_con None [])))
         | [lp,p,rp] => bind (expect_tok lp LparT) (fn _ =>
           bind (expect_tok rp RparT) (fn _ => ptree_PPattern p))
         | [lp,p,colon,ty,rp] => bind (expect_tok lp LparT) (fn _ =>
           bind (expect_tok rp RparT) (fn _ => bind (expect_tok colon ColonT) (fn _ =>
           bind (ptree_PPattern p) (fn pp => fmap (fn t => Pp_tannot pp t) (ptree_Type ty)))))
         | _ => Inl (l,"Impossible: nPPar"))
      else if n = Inl NPatLiteral then
        (case args of [arg] => choice (fmap (fn lit => Pp_lit lit) (ptree_Literal arg))
           (fn _ => fmap (fn b => Pp_con (Some b) []) (ptree_Bool arg))
         | [minus,arg] => bind (expect_tok minus MinusT) (fn _ =>
           bind (token arg) (fn tk => case tk of IntT i => Inr (Pp_lit (Ast.Intlit (~i)))
             | _ => Inl (l,"Impossible: nPatLiteral")))
         | _ => Inl (l,"Impossible: nPatLiteral"))
      else if n = Inl NPBase then
        (case args of [arg] => bind (nterm_of arg) (fn nt =>
           if nt = Inl NValueName then fmap (fn v => Pp_var v) (ptree_ValueName arg)
           else if nt = Inl NConstr then fmap (fn id => Pp_con (Some id) []) (constr_id l arg)
           else if member nt [Inl NPatLiteral,Inl NPAny,Inl NPList,Inl NPPar] then ptree_PPattern arg
           else Inl (l,"Impossible: nPBase"))
         | _ => Inl (l,"Impossible: nPBase"))
      else if n = Inl NPCons then
        (case args of [cn] => choice
           (fmap (fn id => Pp_con (Some id) []) (constr_id l cn)) (fn _ => ptree_PPattern cn)
         | [cn,arg] => choice (bind (constr_id l cn) (fn id =>
             fmap (fn fs => Pp_record id fs) (ptree_PRecFields arg)))
           (fn _ => bind (constr_id l cn) (fn id => fmap (compatCurryP id) (ptree_PPattern arg)))
         | _ => Inl (l,"Impossible: nPCons"))
      else if n = Inl NPAs then
        (case args of p::asids => bind (ptree_PPattern p) (fn pp =>
           fmap (fn ns => case ns of [] => pp | _ => Pp_alias pp ns) (ptree_AsIds asids))
         | _ => Inl (l,"Impossible: nPAs"))
      else if n = Inl NPOps then
        (case args of [] => Inl (l,"Impossible: nPOps")
         | p::rest => bind (ptree_PPattern p) (fn pp =>
           let val start = case dest_alias pp of None => [Inr (Inl pp)]
                 | Some (q,ns) => [Inr (Inr ns),Inl Po_alias,Inr (Inl q)];
           in bind (grabPairs start rest) resolve_precs end))
      else if n = Inl NPattern then
        (case args of [p] => ptree_PPattern p | _ => Inl (l,"Impossible: nPattern"))
      else Inl (l,"Expected a pattern non-terminal")
  and ptree_PPatternList pts = case pts of [] => Inl (unknown_loc,"Pattern lists cannot be empty")
    | [t] => bind (expect_tok t RbrackT) (fn _ => Inr [])
    | p::ps => choice (bind (expect_tok p SemiT) (fn _ => ptree_PPatternList ps))
        (fn _ => bind (ptree_PPattern p) (fn q => fmap (fn qs => q::qs) (ptree_PPatternList ps)))
  and grabPairs acc pts = case pts of [] => Inr (List.rev acc)
    | [_] => Inl (unknown_loc,"grabPairs")
    | pt1::pt2::rest => bind (tok2ppo pt1) (fn oper => bind (ptree_PPattern pt2) (fn v =>
        case dest_alias v of Some (pp,ns) =>
          grabPairs (Inr (Inr ns)::Inl Po_alias::Inr (Inl pp)::Inl oper::acc) rest
        | None => grabPairs (Inr (Inl v)::Inl oper::acc) rest));
  fun ptree_Pattern pt = bind (ptree_PPattern pt) (fn pp => case pp of
      Pp_record id fs => Inr [Inl (id,fs)]
    | _ => choice (fmap (List.map (fn p => Inr p)) (ppat_to_pat pp))
             (fn _ => Inl (unknown_loc,"Record patterns may only appear at the top level")));
  fun ptree_Patterns pt = case pt of Lf (_,l) => Inl (l,"Expected pattern list non-terminal")
    | Nd (n,l) args => if n <> Inl NPatterns then Inl (l,"Expected pattern list non-terminal")
      else case args of [p] => fmap (fn ps => [ps]) (ptree_Pattern p)
        | [p,rest] => bind (ptree_Pattern p) (fn ps => fmap (fn qs => ps::qs) (ptree_Patterns rest))
        | _ => Inl (l,"Impossible: nPatterns");
end;

(*
  Type and constructor metadata and exception declarations. Metadata keeps
  source field order; the preparation helpers below sort each record's fields
  by name. Record functions are generated by the declaration layer.
*)
structure CandleTypeDeclarations = struct
  open CandleTypes;
  type ctor = ((string * Ast.ast_t list),(string * (string * Ast.ast_t) list)) sum;
  type type_info = (Ast.ast_t,ctor list) sum;
  type type_def = CandleLocation.locs * string list * string * type_info;
  fun ptree_FieldDec pt = case pt of
      Lf (_,l) => Inl (l,"Expected a field declaration non-terminal")
    | Nd (n,l) args => if n <> Inl NFieldDec then Inl (l,"Expected a field declaration non-terminal")
      else case args of [field,colon,ty] => bind (expect_tok colon ColonT) (fn _ =>
        bind (ptree_FieldName field) (fn f => fmap (fn t => (f,t)) (ptree_Type ty)))
      | _ => Inl (l,"Impossible: nFieldDec");
  fun ptree_FieldDecs pt = case pt of
      Lf (_,l) => Inl (l,"Expected a field decls non-terminal")
    | Nd (n,l) args => if n <> Inl NFieldDecs then Inl (l,"Expected a field declaration non-terminal")
      else case args of [fd] => fmap (fn f => [f]) (ptree_FieldDec fd)
      | [fd,semi,rest] => bind (expect_tok semi SemiT) (fn _ =>
          bind (ptree_FieldDec fd) (fn f => fmap (fn fs => f::fs) (ptree_FieldDecs rest)))
      | _ => Inl (l,"Impossible: nFieldDecs");
  fun ptree_Record pt = case pt of Lf (_,l) => Inl (l,"Expected a record constructor")
    | Nd (n,l) args => if n <> Inl NRecord then Inl (l,"Expected a record constructor")
      else case args of [lb,fds,semi,rb] => bind (expect_tok lb LbraceT) (fn _ =>
        bind (expect_tok semi SemiT) (fn _ => bind (expect_tok rb RbraceT) (fn _ => ptree_FieldDecs fds)))
      | [lb,fds,rb] => bind (expect_tok lb LbraceT) (fn _ =>
        bind (expect_tok rb RbraceT) (fn _ => ptree_FieldDecs fds))
      | _ => Inl (l,"Impossible: nRecord");
  fun ptree_ConstrArgs pt = case pt of
      Lf (_,l) => Inl (l,"Expected a constructor arguments non-terminal")
    | Nd (n,l) args => if n <> Inl NConstrArgs then Inl (l,"Expected a constructor arguments non-terminal")
      else case args of ty::rest => bind (ptree_Type ty) (fn t =>
        fmap (fn ts => t::ts) (ptree_StarTypes rest))
      | _ => Inl (l,"Impossible: nConstrArgs");
  fun ptree_ConstrDecl pt : ((CandleLocation.locs * string),ctor) sum = case pt of
      Lf (_,l) => Inl (l,"Expected a constructor declaration non-terminal")
    | Nd (n,l) args => if n <> Inl NConstrDecl then Inl (l,"Expected a constructor declaration non-terminal")
      else case args of [name] => fmap (fn nm => Inl (nm,[])) (ptree_ConstrName name)
      | [name,oft,cargs] => bind (expect_tok oft OfT) (fn _ =>
          bind (ptree_ConstrName name) (fn nm => bind (nterm_of cargs) (fn nt =>
            if nt = Inl NRecord then fmap (fn ts => Inr (nm,ts)) (ptree_Record cargs)
            else if nt = Inl NConstrArgs then fmap (fn ts => Inl (nm,ts)) (ptree_ConstrArgs cargs)
            else Inl (l,"Impossible: nConstrDecl"))))
      | _ => Inl (l,"Impossible: nConstrDecl");
  fun ptree_ExcType pt = case pt of
      Lf (_,l) => Inl (l,"Expected an exception type declaration non-terminal")
    | Nd (n,l) args => if n <> Inl NExcType then Inl (l,"Expected an exception type declaration non-terminal")
      else case args of [exnt,cdecl] => bind (expect_tok exnt ExceptionT) (fn _ =>
        bind (ptree_ConstrDecl cdecl) (fn res => case res of
          Inr _ => Inl (l,"Record type exceptions are forbidden") | Inl _ => Inr ()))
      | _ => Inl (l,"Impossible: nExcType");
  fun ctor_tup tys = case tys of _::_::_ => [Ast.Attup tys] | _ => tys;
  fun ptree_ExcDefinition pt = case pt of
      Lf (_,l) => Inl (l,"Expected an exception definition non-terminal")
    | Nd (n,l) args => if n <> Inl NExcDefinition then Inl (l,"Expected an exception definition non-terminal")
      else case args of [exnt,cdecl] => bind (expect_tok exnt ExceptionT) (fn _ =>
        bind (ptree_ConstrDecl cdecl) (fn res => case res of
          Inr _ => Inl (l,"Record type exceptions are forbidden")
        | Inl (nm,ts) => Inr (Ast.Dexn (to_locs l) nm (ctor_tup ts))))
      | [exnt,lhs,eq,rhs] => Inl (l,"Exception abbreviation is not supported")
      | _ => Inl (l,"Impossible: nExcDefinition");
  fun ptree_TypeRepr pt = case pt of Lf (_,l) => Inl (l,"Expected a type-repr non-terminal")
    | Nd (n,l) args =>
      if n = Inl NTypeRepr then
        (case args of [bar,cd,rest] => bind (expect_tok bar BarT) (fn _ =>
           bind (ptree_ConstrDecl cd) (fn tr => fmap (fn trs => tr::trs) (ptree_TypeRepr rest)))
         | [a,b] => choice (bind (expect_tok a BarT) (fn _ =>
             fmap (fn tr => [tr]) (ptree_ConstrDecl b)))
           (fn _ => bind (ptree_ConstrDecl a) (fn tr =>
             fmap (fn trs => tr::trs) (ptree_TypeRepr b)))
         | [cd] => fmap (fn tr => [tr]) (ptree_ConstrDecl cd)
         | _ => Inl (l,"Impossible: nTypeRepr"))
      else if n = Inl NTypeReprs then
        (case args of [bar,cd] => bind (expect_tok bar BarT) (fn _ =>
           fmap (fn ts => [ts]) (ptree_ConstrDecl cd))
         | [bar,cd,rest] => bind (expect_tok bar BarT) (fn _ =>
           bind (ptree_ConstrDecl cd) (fn ts => fmap (fn trs => ts::trs) (ptree_TypeRepr rest)))
         | _ => Inl (l,"Impossible: nTypeReprs"))
      else Inl (l,"Expected a type-repr non-terminal");
  fun ptree_TypeInfo pt = case pt of Lf (_,l) => Inl (l,"Expected a type-info non-terminal")
    | Nd (n,l) args => if n <> Inl NTypeInfo then Inl (l,"Expected a type-info non-terminal")
      else case args of [eq,arg] => bind (expect_tok eq EqualT) (fn _ =>
        bind (nterm_of arg) (fn nt =>
          if nt = Inl NType then fmap (fn t => Inl t) (ptree_Type arg)
          else if nt = Inl NTypeRepr then fmap (fn ts => Inr ts) (ptree_TypeRepr arg)
          else Inl (l,"Impossible: nTypeInfo")))
      | _ => Inl (l,"Impossible: nTypeInfo");
  fun ptree_TypeName pt = case pt of Lf (_,l) => Inl (l,"Expected type variable non-terminal")
    | Nd (n,l) args => if n <> Inl NTVar then Inl (l,"Expected type variable non-terminal")
      else case args of [tick,id] => bind (expect_tok tick TickT) (fn _ => ptree_Ident id)
      | _ => Inl (l,"Impossible: nTVar");
  fun ptree_TypeParamList pts = case pts of [] => Inl (unknown_loc,"Empty type parameters are not supported")
    | [t] => bind (expect_tok t RparT) (fn _ => Inr [])
    | p::ps => choice (bind (expect_tok p CommaT) (fn _ => ptree_TypeParamList ps))
        (fn _ => bind (ptree_TypeName p) (fn t => fmap (fn ts => t::ts) (ptree_TypeParamList ps)));
  fun ptree_TypeParams pt = case pt of Lf (_,l) => Inl (l,"Expected a type-parameters non-terminal")
    | Nd (n,l) args => if n <> Inl NTypeParams then Inl (l,"Expected a type-parameters non-terminal")
      else case args of [tv] => fmap (fn t => [t]) (ptree_TypeName tv)
      | lp::tv::rest => bind (expect_tok lp LparT) (fn _ =>
          bind (ptree_TypeName tv) (fn tn => fmap (fn ts => tn::ts) (ptree_TypeParamList rest)))
      | _ => Inl (l,"Impossible: nTypeParams");
  fun ptree_TypeDef pt : ((CandleLocation.locs * string),type_def) sum = case pt of
      Lf (_,l) => Inl (l,"Expected a typedef non-terminal")
    | Nd (n,l) args => if n <> Inl NTypeDef then Inl (l,"Expected a typedef non-terminal")
      else case args of [params,id,info] => bind (ptree_TypeParams params) (fn tys =>
        bind (ptree_TypeConstrName id) (fn nm => fmap (fn trs => (l,tys,nm,trs)) (ptree_TypeInfo info)))
      | [id,info] => choice (bind (ptree_TypeConstrName id) (fn nm =>
          fmap (fn trs => (l,[],nm,trs)) (ptree_TypeInfo info)))
        (fn _ => bind (ptree_TypeParams id) (fn tys =>
          fmap (fn nm => (l,tys,nm,Inr [])) (ptree_TypeConstrName info)))
      | [id] => fmap (fn nm => (l,[],nm,Inr [])) (ptree_TypeConstrName id)
      | _ => Inl (l,"Impossible: nTypeDef");
  fun ptree_TypeDefs pt = case pt of Lf (_,l) => Inl (l,"Expected a typedef:s non-terminal")
    | Nd (n,l) args => if n <> Inl NTypeDefs then Inl (l,"Expected a typedef:s non-terminal")
      else case args of [td] => fmap (fn t => [t]) (ptree_TypeDef td)
      | [td,andt,rest] => bind (expect_tok andt AndT) (fn _ =>
          bind (ptree_TypeDef td) (fn t => fmap (fn ts => t::ts) (ptree_TypeDefs rest)))
      | _ => Inl (l,"Impossible: nTypeDefs");
  (* sorting.PARTITION prepends to each accumulator, reversing both groups.
     The final converter separately reverses its input before partitioning. *)
  fun partition_types tdefs =
    let fun loop xs abbrevs datas = case xs of [] => (abbrevs,datas)
      | (l,vs,n,tr)::rest => (case tr of
          Inl ty => loop rest ((l,vs,n,ty)::abbrevs) datas
        | Inr cs => loop rest abbrevs ((l,vs,n,cs)::datas))
    in loop tdefs [] [] end;
  fun sort_records (l,vs,n,cs) = (l,vs,n,List.map (fn c => case c of
      Inl plain => Inl plain
    | Inr (cn,fields) => Inr (cn,List.sort (fn (a,_) => fn (b,_) => String.< a b) fields)) cs);
  fun map_outr f xs = case xs of [] => []
    | Inl _::rest => map_outr f rest
    | Inr x::rest => f x::map_outr f rest;
  fun extract_record_defns (l,vs,n,cs) =
    map_outr (fn (cn,fields) => (l,cn,List.map (fn (f,_) => f) fields)) cs;
  fun strip_record_fields (l,vs,n,cs) = (l,vs,n,List.map (fn c => case c of
      Inl (cn,tys) => (cn,ctor_tup tys)
    | Inr (cn,fields) => (cn,ctor_tup (List.map (fn (_,ty) => ty) fields))) cs);
  fun ptree_Semis pt = case pt of Lf (_,l) => Inl (l,"Expected a semicolons-list non-terminal")
    | Nd (n,l) args => if n <> Inl NSemis then Inl (l,"Expected a semicolons-list non-terminal")
      else case args of [s] => expect_tok s SemisT
      | [s,rest] => bind (expect_tok s SemisT) (fn _ => ptree_Semis rest)
      | _ => Inl (l,"Impossible: nSemis");
  fun ptree_ValType pt = case pt of Lf (_,l) => Inl (l,"Expected a val-type declaration non-terminal")
    | Nd (n,l) args => if n <> Inl NValType then Inl (l,"Expected a val-type declaration non-terminal")
      else case args of [valt,valn,colon,ty] => bind (expect_tok valt ValT) (fn _ =>
        bind (expect_tok colon ColonT) (fn _ => bind (ptree_ValueName valn) (fn _ =>
        fmap (fn _ => ()) (ptree_Type ty))))
      | _ => Inl (l,"Impossible: nValType");
  fun ptree_OpenMod pt = case pt of Lf (_,l) => Inl (l,"Expected a module-open non-terminal")
    | Nd (n,l) args => if n <> Inl NOpenMod then Inl (l,"Expected a module-open non-terminal")
      else case args of [opent,path] => bind (expect_tok opent OpenT) (fn _ =>
        fmap (fn _ => ()) (ptree_ModulePath path))
      | _ => Inl (l,"Impossible: nOpenMod");
  fun ptree_IncludeMod pt = case pt of Lf (_,l) => Inl (l,"Expected a module-open non-terminal")
    | Nd (n,l) args => if n <> Inl NIncludeMod then Inl (l,"Expected a module-open non-terminal")
      else case args of [incl,path] => bind (expect_tok incl IncludeT) (fn _ =>
        fmap (fn _ => ()) (ptree_ModulePath path))
      | _ => Inl (l,"Impossible: nIncludeMod");
end;

(*
  Expression lowering helpers. Ast.Ident is the runtime spelling of HOL's
  Var.
*)
structure CandleExpressionSupport = struct
  open CandlePatterns;
  fun compatCurryE id e = case id of
      Ast.Long mn vn =>
        if mn = "PrettyPrinter" andalso vn = Ast.Short "PP_Data" then
          (case e of Ast.Con None xs => Ast.Con (Some id) xs
           | _ => Ast.Con (Some id) [e])
        else Ast.Con (Some id) [e]
    | Ast.Short nm =>
        if member nm ["Abs","Var","Const","Comb","Tyapp","Sequent","Append"] then
          (case e of Ast.Con None xs => Ast.Con (Some id) xs
           | _ => Ast.Con (Some id) [e])
        else if nm = "Ref" then Ast.App Ast.Opref [e]
        else Ast.Con (Some id) [e];
  fun build_binop s x y = if s = "&&" then Ast.Log Ast.Andalso x y
    else if s = "||" then Ast.Log Ast.Orelse x y
    else Ast.App Ast.Opapp [Ast.App Ast.Opapp [Ast.Ident (Ast.Short s),x],y];
  fun build_list_exp xs = List.foldr (fn t => fn e =>
      Ast.Con (Some (Ast.Short "::")) [t,e]) (Ast.Con (Some (Ast.Short "[]")) []) xs;
  fun build_funapp f xs = List.foldl (fn b => fn a => case a of
      Ast.Ident (Ast.Short "raise") => Ast.Raise b
    | _ => Ast.App Ast.Opapp [a,b]) f xs;
  fun mk_record_update_name field cons = "{record_update(" ^ cons ^ "." ^ field ^ ")}";
  fun id_map f id = case id of Ast.Long mn vn => Ast.Long mn (id_map f vn)
    | Ast.Short nm => Ast.Short (f nm);
  fun build_record_upd cons b pair = case pair of (f,x) =>
    Ast.App Ast.Opapp [Ast.App Ast.Opapp
      [Ast.Ident (id_map (mk_record_update_name f) cons),b],x];
  fun mk_record_proj_name field cons = "{record_projection(" ^ cons ^ "." ^ field ^ ")}";
  fun build_record_proj cons f x = Ast.App Ast.Opapp
    [Ast.Ident (id_map (mk_record_proj_name f) cons),x];
  fun mk_record_constr_name cons fields = String.concat
    (["{record_constructor(",cons,")"] @ List.map (fn f => "(" ^ f ^ ")") fields @ ["}"]);
  fun build_record_cons_id fields path = case path of
      [] => Inl (unknown_loc,"build_record_cons_id: empty path")
    | [cn] => Inr (Ast.Short (mk_record_constr_name cn fields))
    | c::cs => fmap (fn id => Ast.Long c id) (build_record_cons_id fields cs);
  fun build_record_cons path upds =
    let val sorted = List.sort (fn (f,_) => fn (g,_) => String.< f g) upds
    in fmap (fn id => build_funapp (Ast.Ident id) (List.map (fn (_,e) => e) sorted))
      (build_record_cons_id (List.map (fn (f,_) => f) sorted) path) end;
  fun mk_record_match_aux recv cons body fields = case fields of [] => body
    | f::fs => Ast.Let (Some f) (build_record_proj cons f (Ast.Ident (Ast.Short recv)))
        (mk_record_match_aux recv cons body fs);
  fun mk_record_match cons fs recv body = Ast.Mat (Ast.Ident (Ast.Short recv))
    [(Ast.Pcon (Some cons) [Ast.Pany],mk_record_match_aux recv cons body fs)];
  fun build_fun_lam body pats = List.foldr (fn p => fn b => case p of
      Inl (c,fs) => Ast.Fun "" (mk_record_match c fs "" b)
    | Inr (Ast.Pvar x) => Ast.Fun x b
    | Inr p => Ast.Fun "" (Ast.Mat (Ast.Ident (Ast.Short "")) [(p,b)])) body pats;
  fun build_letrec binds = List.map (fn (f,ps,x) => case ps of
      [] => (f,("",Ast.App Ast.Opapp [x,Ast.Ident (Ast.Short "")]))
    | Inl (c,fs)::rest => (f,("",mk_record_match c fs "" (build_fun_lam x rest)))
    | Inr (Ast.Pvar v)::rest => (f,(v,build_fun_lam x rest))
    | Inr p::rest => (f,("",Ast.Mat (Ast.Ident (Ast.Short "")) [(p,build_fun_lam x rest)]))) binds;
  (* HOL's formal names are misleading: its FOLDR takes body first, binds second. *)
  fun build_lets body binds = List.foldr (fn b => fn rest => case b of
      Inl (Inl (c,fs),x) => Ast.Let (Some " r") x (mk_record_match c fs " r" rest)
    | Inl (Inr (Ast.Pvar v),x) => Ast.Let (Some v) x rest
    | Inl (Inr Ast.Pany,x) => Ast.Let None x rest
    | Inl (Inr p,x) => Ast.Mat x [(p,rest)]
    | Inr (f,ps,bd) => Ast.Let (Some f) (build_fun_lam bd ps) rest) body binds;
  fun build_match_row mvar row = case row of
      (Inl (c,fs),x) => (Ast.Pcon (Some c) [Ast.Pany],mk_record_match c fs mvar x)
    | (Inr p,x) => (p,x);
  fun smartMat mvar rows = case rows of [(Inr Ast.Pany,y)] => y
    | _ => Ast.Mat (Ast.Ident (Ast.Short mvar)) (List.map (build_match_row mvar) rows);
  fun build_pmatch mvar acc rows = case rows of [] => smartMat mvar acc
    | (pat,e,None)::ps => build_pmatch mvar ((pat,e)::acc) ps
    | (pat,e,Some guard)::ps =>
        let val mexp = smartMat mvar acc
            val call = Ast.App Ast.Opapp [Ast.Ident (Ast.Short " p"),Ast.Con None []]
            val mat = smartMat mvar [(pat,Ast.If guard e call),(Inr Ast.Pany,call)]
            val clos = Ast.Let (Some " p") (Ast.Fun " u" mexp) mat
        in build_pmatch mvar [(Inr Ast.Pany,clos)] ps end;
  fun build_match x rows = Ast.Let (Some " m") x
    (if List.exists (fn (_,_,g) => case g of Some _ => True | _ => False) rows then
       build_pmatch " m" [] (List.rev rows)
     else Ast.Mat (Ast.Ident (Ast.Short " m"))
       (List.map (fn (p,e,_) => build_match_row " m" (p,e)) rows));
  fun build_handle x rows = Ast.Handle x [(Ast.Pvar " e",build_pmatch " e" []
    ((Inr Ast.Pany,Ast.Raise (Ast.Ident (Ast.Short " e")),None)::List.rev rows))];
  fun build_function rows = Ast.Fun "" (build_pmatch "" [] (List.rev rows));
  fun flatten_pmatch rows = List.concat
    (List.map (fn (ps,x,w) => List.map (fn p => (p,x,w)) ps) rows);
end;

(*
  The mutually recursive ptree_Expr family, converting expression parse
  trees. check_tokens sequences expect_tok calls; expr_binary shares the
  identical binary-tier clauses and their evaluation order.
*)
structure CandleExpressions = struct
  open CandleExpressionSupport;
  fun check_tokens pairs = case pairs of [] => Inr () | (p,t)::rest =>
    bind (expect_tok p t) (fn _ => check_tokens rest);
  fun single_patterns loc msg pss =
    if List.all (fn ps => List.length ps = 1) pss then Inr (List.concat pss)
    else Inl (loc,msg);
  fun ptree_Expr et pt = case pt of Lf (_,l) => Inl (l,"Expected an expression non-terminal")
    | Nd (n,l) args =>
      let fun err s = Inl (l,s)
          fun unary nt s = case args of [a] => ptree_Expr nt a | _ => err s
          fun dispatch nts bad arity = case args of [a] => bind (nterm_of a) (fn m =>
            case m of Inl nt => if member nt nts then ptree_Expr nt a else err bad
              | _ => err bad) | _ => err arity
          fun binary single left right bad = expr_binary single left right l bad args
          fun rec_update checks c x u = bind (check_tokens checks) (fn _ =>
            bind (ptree_Expr NExpr x) (fn e => bind (ptree_Updates u) (fn us =>
            bind (ptree_Constr c) (fn path => fmap (fn ns =>
              List.foldl (fn upd => fn b => build_record_upd ns b upd) e us)
              (path_to_ns l path)))))
          fun rec_cons checks c u = bind (check_tokens checks) (fn _ =>
            bind (ptree_Constr c) (fn path => bind (ptree_Updates u) (build_record_cons path)))
      in if n <> Inl et then err "ptree_Expr" else case et of
        NExpr => unary NESeq "Impossible: nExpr"
      | NEUnclosed => dispatch [NELet,NELetRec,NEMatch,NEFun,NEFunction,NETry,NEWhile,NEFor,NEApp]
          "Expected an expression non-terminal" "Impossible: nEUnclosed"
      | NEList => (case args of lb::rest => bind (expect_tok lb LbrackT) (fn _ =>
          fmap build_list_exp (ptree_ExprList rest)) | _ => err "Impossible: nEList")
      | NEBase => (case args of
          [lp,rp] => choice
            (bind (check_tokens [(lp,LparT),(rp,RparT)]) (fn _ => Inr (Ast.Con None [])))
            (fn _ => bind (check_tokens [(lp,BeginT),(rp,EndT)]) (fn _ => Inr (Ast.Con None [])))
        | [lp,e,rp] => choice
            (bind (check_tokens [(lp,LparT),(rp,RparT)]) (fn _ => ptree_Expr NExpr e))
            (fn _ => bind (check_tokens [(lp,BeginT),(rp,EndT)]) (fn _ => ptree_Expr NExpr e))
        | [lp,e,colon,ty,rp] => bind (check_tokens [(lp,LparT),(rp,RparT),(colon,ColonT)])
            (fn _ => bind (ptree_Type ty) (fn t => fmap (fn x => Ast.Tannot x t) (ptree_Expr NExpr e)))
        | [a] => bind (nterm_of a) (fn m => case m of
            Inl NERecUpdate => ptree_Expr NERecUpdate a
          | Inl NLiteral => choice (fmap (fn id => Ast.Con (Some id) []) (ptree_Bool a))
              (fn _ => fmap (fn x => Ast.Lit x) (ptree_Literal a))
          | Inl NValuePath => bind (ptree_ValuePath a) (fn path =>
              fmap (fn id => Ast.Ident id) (path_to_ns l path))
          | Inl NConstr => bind (ptree_Constr a) (fn path =>
              fmap (fn id => Ast.Con (Some id) []) (path_to_ns l path))
          | Inl NEList => ptree_Expr NEList a
          | _ => err "Impossible: nEBase")
        | _ => err "Impossible: nEBase")
      | NERecUpdate => (case args of
          [c,lb,x,w,u,s,rb] => rec_update [(lb,LbraceT),(w,WithT),(s,SemiT),(rb,RbraceT)] c x u
        | [c,lb,x,w,u,rb] => rec_update [(lb,LbraceT),(w,WithT),(rb,RbraceT)] c x u
        | _ => err "Impossible: nERecUpdate")
      | NEIndex => (case args of [a] => ptree_Expr NEPrefix a
        | [a,i] => bind (ptree_Expr NEPrefix a) (fn x => fmap (fn idx => case idx of
            Inl e => build_funapp (Ast.Ident (Ast.Long "String" (Ast.Short "get"))) [x,e]
          | Inr e => build_funapp (Ast.Ident (Ast.Long "Array" (Ast.Short "get"))) [x,e]) (ptree_Index i))
        | _ => err "Impossible: nEIndex")
      | NERecProj => (case args of [a] => ptree_Expr NEIndex a
        | [a,d1,c,d2,f] => bind (check_tokens [(d1,DotT),(d2,DotT)]) (fn _ =>
            bind (ptree_Expr NEIndex a) (fn x => bind (ptree_FieldName f) (fn field =>
            bind (ptree_Constr c) (fn path => fmap (fn ns => build_record_proj ns field x)
              (path_to_ns l path)))))
        | _ => err "Impossible: nERecProj")
      | NERecCons => (case args of
          [c,lb,u,s,rb] => rec_cons [(lb,LbraceT),(s,SemiT),(rb,RbraceT)] c u
        | [c,lb,u,rb] => rec_cons [(lb,LbraceT),(rb,RbraceT)] c u
        | _ => err "Impossible: nERecCons")
      | NEAssert => (case args of [kw,e] => bind (expect_tok kw AssertT) (fn _ =>
          fmap (fn x => Ast.App Ast.Opapp [Ast.Ident (Ast.Short "assert"),x]) (ptree_Expr NERecProj e))
        | _ => err "Impossible: nEAssert")
      | NELazy => (case args of [kw,e] => bind (expect_tok kw LazyT) (fn _ =>
          fmap (fn x => Ast.App Ast.Opapp [Ast.Ident (Ast.Short "lazy"),x]) (ptree_Expr NERecProj e))
        | _ => err "Impossible: nELazy")
      | NEConstr => (case args of [c,e] => bind (ptree_Constr c) (fn path =>
          bind (path_to_ns l path) (fn id => fmap (compatCurryE id) (ptree_Expr NERecProj e)))
        | _ => err "Impossible: nEConstr")
      | NEFunapp => (case args of [e] => ptree_Expr NERecProj e
        | [f,a] => bind (ptree_Expr NEFunapp f) (fn x =>
            fmap (fn y => build_funapp x [y]) (ptree_Expr NERecProj a))
        | _ => err "Impossible: nEFunapp")
      | NEApp => dispatch [NELazy,NEAssert,NEConstr,NEFunapp,NERecCons,NERecProj]
          "Impolssible: nEApp" "Impossible: nEApp"
      | NEPrefix => (case args of [oper,e] => bind (ptree_Op oper) (fn s =>
          fmap (fn x => Ast.App Ast.Opapp [Ast.Ident (Ast.Short s),x]) (ptree_Expr NEBase e))
        | [e] => ptree_Expr NEBase e | _ => err "Impossible: nEPrefix")
      | NENeg => (case args of [pref,e] => bind (token pref) (fn tk =>
          bind (ptree_Expr NEUnclosed e) (fn x =>
            let fun app s = Inr (Ast.App Ast.Opapp [Ast.Ident (Ast.Short s),x])
            in case tk of MinusT => app "~-" | MinusFT => app "~-."
              | SymbolT s => app s | _ => err "Impossible: nEPrefix" end))
        | [e] => ptree_Expr NEUnclosed e | _ => err "Impossible: nEPrefix")
      | NEShift => binary NENeg NENeg NEShift "Impossible: nEShift"
      | NEMult => binary NEShift NEMult NEShift "Impossible: nMult"
      | NEAdd => binary NEMult NEAdd NEMult "Impossible: nEAdd"
      | NECons => (case args of [e] => ptree_Expr NEAdd e
        | [x,c,y] => bind (expect_tok c ColonsT) (fn _ => bind (ptree_Expr NEAdd x)
            (fn a => fmap (fn b => Ast.Con (Some (Ast.Short "::")) [a,b]) (ptree_Expr NECons y)))
        | _ => err "Impossible: nECons")
      | NECat => binary NECons NECons NECat "Impossible: nECat"
      | NERel => binary NECat NERel NECat "Impossible: nERel"
      | NEAnd => binary NERel NERel NEAnd "Impossible: nEAnd"
      | NEOr => binary NEAnd NEAnd NEOr "Impossible: nEOr"
      | NEHolInfix => binary NEOr NEHolInfix NEOr "Impossible: nEHolInfix"
      | NEProd => (case args of [e] => ptree_Expr NEHolInfix e
        | e::rest => bind (ptree_Expr NEHolInfix e) (fn x =>
            fmap (fn xs => Ast.Con None (x::xs)) (ptree_ExprCommas rest))
        | _ => err "Impossible: nEProd")
      | NEAssign => binary NEProd NEProd NEAssign "Impossible: nEAssign"
      | NEIf => (case args of [ift,x,th,y,els,z] =>
          bind (check_tokens [(ift,IfT),(th,ThenT),(els,ElseT)]) (fn _ =>
          bind (ptree_Expr NExpr x) (fn a => bind (ptree_Expr NEIf y) (fn b =>
          fmap (fn c => Ast.If a b c) (ptree_Expr NEIf z))))
        | [ift,x,th,y] => bind (check_tokens [(ift,IfT),(th,ThenT)]) (fn _ =>
          bind (ptree_Expr NExpr x) (fn a => fmap (fn b => Ast.If a b (Ast.Con None [])) (ptree_Expr NEIf y)))
        | [e] => ptree_Expr NEAssign e | _ => err "Impossible: nEIf")
      | NESeq => (case args of [x,s,y] => bind (expect_tok s SemiT) (fn _ =>
          bind (ptree_Expr NEIf x) (fn a => fmap (fn b => Ast.Let None a b) (ptree_Expr NExpr y)))
        | [e] => ptree_Expr NEIf e | _ => err "Impossible: nESeq")
      | NELetRec => (case args of [lt,rc,bs,it,e] =>
          bind (check_tokens [(lt,LetT),(rc,RecT),(it,InT)]) (fn _ =>
          bind (ptree_LetRecBindings bs) (fn binds => fmap (fn x => Ast.Letrec (build_letrec binds) x)
            (ptree_Expr NExpr e))) | _ => err "Impossible: nELetRec")
      | NELet => (case args of [lt,bs,it,e] => bind (check_tokens [(lt,LetT),(it,InT)]) (fn _ =>
          bind (ptree_LetBindings bs) (fn binds => fmap (fn x => build_lets x binds) (ptree_Expr NExpr e)))
        | _ => err "Impossible: nELet")
      | NEMatch => (case args of [mt,e,wt,pm] => bind (check_tokens [(mt,MatchT),(wt,WithT)]) (fn _ =>
          bind (ptree_Expr NExpr e) (fn x => fmap (fn rows => build_match x (flatten_pmatch rows))
            (ptree_PatternMatch pm))) | _ => err "Impossible: nEMatch")
      | NEFun => (case args of [ft,ps,ar,e] => bind (check_tokens [(ft,FunT),(ar,RarrowT)]) (fn _ =>
          bind (ptree_Patterns ps) (fn pats => bind (ptree_Expr NExpr e) (fn x =>
          fmap (build_fun_lam x) (single_patterns l "Or-patterns are not allowed in fun expressions" pats))))
        | [ft,ps,colon,ty,ar,e] => bind (check_tokens [(ft,FunT),(ar,RarrowT)]) (fn _ =>
          bind (ptree_Patterns ps) (fn pats => bind (ptree_Expr NExpr e) (fn x =>
          bind (ptree_Type ty) (fn t => fmap (fn qs => Ast.Tannot (build_fun_lam x qs) t)
            (single_patterns l "Or-patterns are not allowed in fun expressions" pats)))))
        | _ => err "Impossible: nEFun")
      | NEFunction => (case args of [ft,pm] => bind (expect_tok ft FunctionT) (fn _ =>
          fmap (fn rows => build_function (flatten_pmatch rows)) (ptree_PatternMatch pm))
        | _ => err "Impossible: nEFunction")
      | NETry => (case args of [tt,e,wt,pm] => bind (check_tokens [(tt,TryT),(wt,WithT)]) (fn _ =>
          bind (ptree_Expr NExpr e) (fn x => fmap (fn rows => build_handle x (flatten_pmatch rows))
            (ptree_PatternMatch pm))) | _ => err "Impossible: nETry")
      | NEWhile => (case args of [wt,e,dt,b,done] =>
          bind (check_tokens [(wt,WhileT),(dt,DoT),(done,DoneT)]) (fn _ =>
          bind (ptree_Expr NExpr e) (fn x => fmap (fn y =>
            build_funapp (Ast.Ident (Ast.Short "while")) [x,y]) (ptree_Expr NExpr b)))
        | _ => err "Impossible: nEWhile")
      | NEFor => (case args of [ft,id,eq,u,dir,d,dt,b,done] =>
          bind (check_tokens [(ft,ForT),(eq,EqualT),(dt,DoT)]) (fn _ => bind (token dir) (fn tk =>
          if tk <> ToT andalso tk <> DowntoT then err "Expected 'to' or 'downto'" else
          bind (ptree_ValueName id) (fn nm => bind (ptree_Expr NExpr u) (fn ub =>
          bind (ptree_Expr NExpr d) (fn lb => fmap (fn body =>
            build_funapp (Ast.Ident (Ast.Short "for"))
              [Ast.Con (Some (bool2id (tk = ToT))) [],Ast.Ident (Ast.Short nm),ub,lb,body])
              (ptree_Expr NExpr b))))))
        | _ => err "Impossible: nEFor")
      | _ => err "ptree_Expr" end
  and expr_binary single left right l bad args = case args of
      [e] => ptree_Expr single e
    | [x,oper,y] => bind (ptree_Expr left x) (fn a => bind (ptree_Expr right y) (fn b =>
        fmap (fn s => build_binop s a b) (ptree_Op oper)))
    | _ => Inl (l,bad)
  and ptree_LetRecBinding pt = case pt of Lf (_,l) => Inl (l,"Expected a let rec binding non-terminal")
    | Nd (n,l) args =>
      let fun finish nm ps x = fmap (fn qs => (nm,qs,x))
            (single_patterns l "Or-patterns are not allowed in let (rec) bindings" ps)
      in if n <> Inl NLetRecBinding then Inl (l,"Expected a let rec binding non-terminal") else case args of
        [id,ps,c,ty,eq,e] => bind (check_tokens [(c,ColonT),(eq,EqualT)]) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Patterns ps) (fn qs =>
          bind (ptree_Type ty) (fn t => bind (ptree_Expr NExpr e) (fn x => finish nm qs (Ast.Tannot x t))))))
      | [id,ps,eq,e] => bind (expect_tok eq EqualT) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Patterns ps) (fn qs =>
          bind (ptree_Expr NExpr e) (finish nm qs))))
      | [id,c,ty,eq,e] => bind (check_tokens [(eq,EqualT),(c,ColonT)]) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Type ty) (fn t =>
          fmap (fn x => (nm,[],Ast.Tannot x t)) (ptree_Expr NExpr e))))
      | [id,eq,e] => bind (expect_tok eq EqualT) (fn _ => bind (ptree_ValueName id) (fn nm =>
          fmap (fn x => (nm,[],x)) (ptree_Expr NExpr e)))
      | _ => Inl (l,"Impossible: nLetRecBinding") end
  and ptree_LetRecBindings pt = case pt of Lf (_,l) => Inl (l,"Expected a list of let rec bindings non-terminal")
    | Nd (n,l) args => if n <> Inl NLetRecBindings then Inl (l,"Expected a list of let rec bindings non-terminal")
      else case args of [b] => fmap (fn x => [x]) (ptree_LetRecBinding b)
      | [b,a,bs] => bind (expect_tok a AndT) (fn _ => bind (ptree_LetRecBinding b) (fn x =>
          fmap (fn xs => x::xs) (ptree_LetRecBindings bs)))
      | _ => Inl (l,"Impossible: nLetRecBindings")
  and ptree_LetBinding pt = case pt of Lf (_,l) => Inl (l,"Expected a let binding non-terminal")
    | Nd (n,l) args =>
      let fun finish nm ps x = fmap (fn qs => Inr (nm,qs,x))
            (single_patterns l "Or-patterns are not allowed in let (rec) bindings" ps)
      in if n <> Inl NLetBinding then Inl (l,"Expected a let binding non-terminal") else case args of
        [p,eq,e] => bind (expect_tok eq EqualT) (fn _ => bind (ptree_Pattern p) (fn ps =>
          bind (ptree_Expr NExpr e) (fn x => case ps of [q] => Inr (Inl (q,x))
            | _ => Inl (l,"Or-patterns are not allowed in let (rec) bindings"))))
      | [id,ps,eq,e] => bind (expect_tok eq EqualT) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Patterns ps) (fn qs =>
          bind (ptree_Expr NExpr e) (finish nm qs))))
      | [id,c,ty,eq,e] => bind (check_tokens [(eq,EqualT),(c,ColonT)]) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Type ty) (fn t =>
          fmap (fn x => Inl (Inr (Ast.Pvar nm),Ast.Tannot x t)) (ptree_Expr NExpr e))))
      | [id,ps,c,ty,eq,e] => bind (check_tokens [(eq,EqualT),(c,ColonT)]) (fn _ =>
          bind (ptree_ValueName id) (fn nm => bind (ptree_Patterns ps) (fn qs =>
          bind (ptree_Type ty) (fn t => bind (ptree_Expr NExpr e) (fn x => finish nm qs (Ast.Tannot x t))))))
      | _ => Inl (l,"Impossible: nLetBinding") end
  and ptree_LetBindings pt = case pt of Lf (_,l) => Inl (l,"Expected a list of let bindings non-terminal")
    | Nd (n,l) args => if n <> Inl NLetBindings then Inl (l,"Expected a list of let bindings non-terminal")
      else case args of [b] => fmap (fn x => [x]) (ptree_LetBinding b)
      | [b,a,bs] => bind (expect_tok a AndT) (fn _ => bind (ptree_LetBinding b) (fn x =>
          fmap (fn xs => x::xs) (ptree_LetBindings bs)))
      | _ => Inl (l,"Impossible: nLetBindings")
  and ptree_PatternMatches pt = case pt of Lf (_,l) => Inl (l,"Expected a pattern-matches non-terminal")
    | Nd (n,l) args => if n <> Inl NPatternMatches then Inl (l,"Expected a pattern-matches non-terminal")
      else case args of
        [a,b,c,d,e] => choice
          (bind (check_tokens [(d,RarrowT),(b,WhenT)]) (fn _ => bind (ptree_Pattern a) (fn p =>
           bind (ptree_Expr NExpr e) (fn x => fmap (fn w => [(p,x,Some w)]) (ptree_Expr NExpr c)))))
          (fn _ => bind (check_tokens [(b,RarrowT),(d,BarT)]) (fn _ => bind (ptree_Pattern a) (fn p =>
           bind (ptree_Expr NExpr c) (fn x => fmap (fn ps => (p,x,None)::ps) (ptree_PatternMatches e)))))
      | [p,w,g,a,e,b,ms] => bind (check_tokens [(a,RarrowT),(w,WhenT)]) (fn _ =>
          bind (ptree_Pattern p) (fn ps => bind (ptree_Expr NExpr e) (fn x =>
          bind (ptree_Expr NExpr g) (fn guard => bind (expect_tok b BarT) (fn _ =>
          fmap (fn rows => (ps,x,Some guard)::rows) (ptree_PatternMatches ms))))))
      | [p,a,e] => bind (expect_tok a RarrowT) (fn _ => bind (ptree_Pattern p) (fn ps =>
          fmap (fn x => [(ps,x,None)]) (ptree_Expr NExpr e)))
      | _ => Inl (l,"Impossible: nPatternMatches")
  and ptree_PatternMatch pt = case pt of Lf (_,l) => Inl (l,"Expected a pattern-match non-terminal")
    | Nd (n,l) args => if n <> Inl NPatternMatch then Inl (l,"Expected a pattern-match non-terminal")
      else case args of [b,ms] => bind (expect_tok b BarT) (fn _ => ptree_PatternMatches ms)
      | [ms] => ptree_PatternMatches ms | _ => Inl (l,"Impossible: nPatternMatch")
  and ptree_ExprList pts = case pts of [] => Inl (unknown_loc,"Expression lists cannot be empty")
    | [t] => bind (expect_tok t RbrackT) (fn _ => Inr [])
    | x::xs => choice (bind (expect_tok x SemiT) (fn _ => ptree_ExprList xs))
        (fn _ => bind (ptree_Expr NEIf x) (fn e => fmap (fn es => e::es) (ptree_ExprList xs)))
  and ptree_ExprCommas pts = case pts of [] => Inr []
    | x::xs => choice (bind (expect_tok x CommaT) (fn _ => ptree_ExprCommas xs))
        (fn _ => bind (ptree_Expr NEHolInfix x) (fn e => fmap (fn es => e::es) (ptree_ExprCommas xs)))
  and ptree_Update pt = case pt of Lf (_,l) => Inl (l,"Expected an update non-terminal")
    | Nd (n,l) args => if n <> Inl NUpdate then Inl (l,"Expected an update non-terminal")
      else case args of [f,eq,e] => bind (expect_tok eq EqualT) (fn _ => bind (ptree_FieldName f)
        (fn nm => fmap (fn x => (nm,x)) (ptree_Expr NEIf e))) | _ => Inl (l,"Impossible: nUpdate")
  and ptree_Updates pt = case pt of Lf (_,l) => Inl (l,"Expected an updates non-terminal")
    | Nd (n,l) args => if n <> Inl NUpdates then Inl (l,"Expected an updates non-terminal")
      else case args of [u] => fmap (fn x => [x]) (ptree_Update u)
      | [u,s,us] => bind (expect_tok s SemiT) (fn _ => bind (ptree_Update u)
          (fn x => fmap (fn xs => x::xs) (ptree_Updates us))) | _ => Inl (l,"Impossible: nUpdates")
  and ptree_Index pt = case pt of Lf (_,l) => Inl (l,"Expected an index non-terminal")
    | Nd (n,l) args => if n = Inl NArrIdx then (case args of [d,lp,e,rp] =>
        bind (check_tokens [(d,DotT),(lp,LparT),(rp,RparT)]) (fn _ =>
          fmap (fn x => Inr x) (ptree_Expr NExpr e)) | _ => Inl (l,"Impossible: nArrIdx"))
      else if n = Inl NStrIdx then (case args of [d,lb,e,rb] =>
        bind (check_tokens [(d,DotT),(lb,LbrackT),(rb,RbrackT)]) (fn _ =>
          fmap (fn x => Inl x) (ptree_Expr NExpr e)) | _ => Inl (l,"Impossible: nStrIdx"))
      else Inl (l,"Expected an index non-terminal");
end;

(*
  Candle declaration lowering. Embedded CakeML pragmas are reported as
  unsupported.
*)
structure CandleDeclarations = struct
  open CandleTypeDeclarations;
  open CandleExpressions;
  val pragma_error = "CakeML pragmas are not supported by this Candle-only parser";
  fun build_rec_funs triple = case triple of (l,cn,fs) =>
    let val ast_locs = to_locs l
        val vars = List.map (fn f => Ast.Ident (Ast.Short f)) fs
        val rhs = Ast.Con (Some (Ast.Short cn))
          (case vars of _::_::_ => [Ast.Con None vars] | _ => vars)
        val constr = Ast.Dlet ast_locs (Ast.Pvar (mk_record_constr_name cn fs))
          (List.foldr (fn f => fn x => Ast.Fun f x) rhs fs)
        val pvars = List.map (fn f => Ast.Pvar f) fs
        val pat = Ast.Pcon (Some (Ast.Short cn))
          (case pvars of _::_::_ => [Ast.Pcon None pvars] | _ => pvars)
        val projs = List.map (fn f => Ast.Dlet ast_locs (Ast.Pvar (mk_record_proj_name f cn))
          (Ast.Fun "" (Ast.Mat (Ast.Ident (Ast.Short "")) [(pat,Ast.Ident (Ast.Short f))]))) fs
        val upds = List.map (fn f => Ast.Dlet ast_locs (Ast.Pvar (mk_record_update_name f cn))
          (Ast.Fun "" (Ast.Mat (Ast.Ident (Ast.Short "")) [(pat,Ast.Fun f rhs)]))) fs
    in constr::(projs @ upds) end;
  fun distinct xs = case xs of [] => True | x::rest => not (member x rest) andalso distinct rest;
  fun ptree_TypeDefinition pt = case pt of
      Lf (_,l) => Inl (l,"Expected a type definition non-terminal")
    | Nd (n,l) args => if n <> Inl NTypeDefinition then Inl (l,"Expected a type definition non-terminal")
      else case args of
        [t,nr,ds] => bind (check_tokens [(t,TypeT),(nr,NonrecT)])
          (fn _ => Inl (l,"nonrec type definitions are not supported"))
      | [t,ds] => bind (expect_tok t TypeT) (fn _ => bind (ptree_TypeDefs ds) (fn tdefs =>
          let val (abbrevs,datas) = partition_types (List.rev tdefs)
          in if abbrevs <> [] andalso datas <> [] then
            Inl (l,"datatypes and type abbreviations cannot be made mutually recursive")
          else let val abs = List.map (fn (loc,tvs,nm,ty) => Ast.Dtabbrev (to_locs loc) tvs nm ty) abbrevs
          in case datas of [] => Inr abs | _ =>
            let val defs = List.map sort_records datas
                val recs = List.concat (List.map extract_record_defns defs)
            in if not (List.all (fn (_,_,fs) => distinct fs) recs) then
              Inl (l,"record field names must be distinct")
            else let val recfuns = List.concat (List.map build_rec_funs recs)
                     val defs = List.map strip_record_fields defs
                     val dt = Ast.Dtype (to_locs l) (List.map (fn (_,tvs,nm,cs) => (tvs,(nm,cs))) defs)
                 in Inr (dt::(abs @ recfuns)) end end end end))
      | _ => Inl (l,"Impossible: nTypeDefinition");
  fun build_dlet l binds =
    let val ast_locs = to_locs l
    in List.map (fn b => case b of
      Inl (Inl (c,fs),x) => Ast.Dlocal [Ast.Dlet ast_locs (Ast.Pvar " c") x]
        (List.map (fn f => Ast.Dlet ast_locs (Ast.Pvar f)
          (build_record_proj c f (Ast.Ident (Ast.Short " c")))) fs)
    | Inl (Inr p,x) => Ast.Dlet ast_locs p x
    | Inr (f,ps,bd) => Ast.Dlet ast_locs (Ast.Pvar f) (build_fun_lam bd ps)) binds end;
  fun ptree_ExprDec l pt = fmap (fn x => [Ast.Dlet (to_locs l) (Ast.Pvar "it") x]) (ptree_Expr NExpr pt);
  fun ptree_ModuleType pt = case pt of Lf (_,l) => Inl (l,"Expected a module-type declaration non-terminal")
    | Nd (n,l) args => if n <> Inl NModuleType then Inl (l,"Expected a module-type declaration non-terminal")
      else case args of [a] => bind (nterm_of a) (fn nt => case nt of
          Inl NModTypePath => fmap (fn _ => ()) (ptree_ModTypePath a)
        | Inl NSigSpec => fmap (fn _ => ()) (ptree_SigSpec a)
        | _ => Inl (l,"Impossible: nModuleType"))
      | [lp,t,rp] => bind (check_tokens [(lp,LparT),(rp,RparT)])
          (fn _ => fmap (fn _ => ()) (ptree_ModuleType t))
      | _ => Inl (l,"Impossible: nModuleType")
  and ptree_SigSpec pt = case pt of Lf (_,l) => Inl (l,"Expected a signature spec non-terminal")
    | Nd (n,l) args => if n <> Inl NSigSpec then Inl (l,"Expected a signature spec non-terminal")
      else case args of [s,its,e] => bind (check_tokens [(s,SigT),(e,EndT)])
          (fn _ => fmap (fn _ => ()) (ptree_SigItems its))
      | [s,e] => check_tokens [(s,SigT),(e,EndT)]
      | _ => Inl (l,"Impossible: nSigSpec")
  and ptree_SigItems pt = case pt of Lf (_,l) => Inl (l,"Expected a signature item list non-terminal")
    | Nd (n,l) args => if n <> Inl NSigItems then Inl (l,"Expected a signature item list non-terminal")
      else case args of [it,s,its] => bind (ptree_Semis s) (fn _ => bind (ptree_SigItem it)
          (fn x => fmap (fn xs => x::xs) (ptree_SigItems its)))
      | [it,rest] => choice (bind (ptree_Semis rest) (fn _ => fmap (fn x => [x]) (ptree_SigItem it)))
          (fn _ => bind (ptree_SigItem it) (fn x => fmap (fn xs => x::xs) (ptree_SigItems rest)))
      | [it] => choice (bind (ptree_Semis it) (fn _ => Inr []))
          (fn _ => fmap (fn x => [x]) (ptree_SigItem it))
      | _ => Inl (l,"Impossible: nSigItems")
  and ptree_SigItem pt = case pt of Lf (_,l) => Inl (l,"Expected a signature item non-terminal")
    | Nd (n,l) args => if n <> Inl NSigItem then Inl (l,"Expected a signature item non-terminal")
      else case args of [a] => bind (nterm_of a) (fn nt => case nt of
          Inl NTypeDefinition => fmap (fn _ => ()) (ptree_TypeDefinition a)
        | Inl NExcType => ptree_ExcType a
        | Inl NValType => ptree_ValType a
        | Inl NModTypeAsc => ptree_ModTypeAsc a
        | Inl NModTypeAssign => ptree_ModTypeAssign a
        | Inl NOpenMod => ptree_OpenMod a
        | Inl NIncludeMod => ptree_IncludeMod a
        | _ => Inl (l,"Impossible: nSigItem"))
      | _ => Inl (l,"Impossible: nSigItem")
  and ptree_ModTypeAssign pt = case pt of Lf (_,l) => Inl (l,"Expected a signature assignment non-terminal")
    | Nd (n,l) args => if n <> Inl NModTypeAssign then Inl (l,"Expected a signature assignment non-terminal")
      else case args of [m,t,name] => bind (check_tokens [(m,ModuleT),(t,TypeT)])
          (fn _ => fmap (fn _ => ()) (ptree_ModTypeName name))
      | [m,t,name,eq,ty] => bind (check_tokens [(m,ModuleT),(t,TypeT),(eq,EqualT)])
          (fn _ => bind (ptree_ModTypeName name) (fn _ => ptree_ModuleType ty))
      | _ => Inl (l,"Impossible: nModTypeAssign")
  and ptree_ModTypeAsc pt = case pt of Lf (_,l) => Inl (l,"Expected a signature ascription non-terminal")
    | Nd (n,l) args => if n <> Inl NModTypeAsc then Inl (l,"Expected a module ascription non-terminal")
      else case args of [m,t,name,apps,c,ty] =>
          Inl (l,"Functor syntax is not supported (you attempted to apply a functor type)")
      | [m,t,name,c,ty] => bind (check_tokens [(m,ModuleT),(t,TypeT),(c,ColonT)])
          (fn _ => bind (ptree_ModuleName name) (fn _ => ptree_ModuleType ty))
      | _ => Inl (l,"Impossible: nModTypeAsc");
  fun ptree_Definition pt = case pt of Lf (_,l) => Inl (l,"Expected a top-level definition non-terminal")
    | Nd (n,l) args =>
      let fun err s = Inl (l,s)
          fun module_result nm mx = case mx of Inl _ => err "Structure assignment is not supported (yet?)"
            | Inr ds => Inr [Ast.Dmod nm ds]
      in case n of
        Inl NDefinition => (case args of [a] => ptree_Definition a | _ => err "Impossible: nDefinition")
      | Inl NCakeMLPragma => err pragma_error
      | Inl NTopLet => (case args of [lt,bs] => bind (expect_tok lt LetT)
          (fn _ => fmap (build_dlet l) (ptree_LetBindings bs)) | _ => err "Impossible: nTopLet")
      | Inl NTopLetRec => (case args of [lt,rc,bs] => bind (check_tokens [(lt,LetT),(rc,RecT)])
          (fn _ => fmap (fn binds => [Ast.Dletrec (to_locs l) (build_letrec binds)]) (ptree_LetRecBindings bs))
        | _ => err "Impossible: nTopLetRec")
      | Inl NTypeDefinition => ptree_TypeDefinition pt
      | Inl NExcDefinition => fmap (fn d => [d]) (ptree_ExcDefinition pt)
      | Inl NOpen => err "open-declarations are not supported (yet)"
      | Inl NModuleTypeDef => (case args of [m,t,name,eq,ty] =>
          bind (check_tokens [(m,ModuleT),(t,TypeT),(eq,EqualT)]) (fn _ =>
          bind (ptree_ModTypeName name) (fn _ => fmap (fn _ => []) (ptree_ModuleType ty)))
        | _ => err "Impossible: nModuleTypeDef")
      | Inl NModuleDef => (case args of [m,id,eq,e] =>
          bind (check_tokens [(m,ModuleT),(eq,EqualT)]) (fn _ => bind (ptree_ModuleName id)
          (fn nm => bind (ptree_ModExpr e) (module_result nm)))
        | [m,id,c,ty,eq,e] => bind (check_tokens [(m,ModuleT),(eq,EqualT),(c,ColonT)]) (fn _ =>
          bind (ptree_ModuleType ty) (fn _ => bind (ptree_ModuleName id)
          (fn nm => bind (ptree_ModExpr e) (module_result nm))))
        | _ => err "Impossible: nModuleDef")
      | _ => err "Expected a top-level definition non-terminal" end
  and ptree_ModExpr pt = case pt of Lf (_,l) => Inl (l,"Expected a module expression non-terminal")
    | Nd (n,l) args => if n <> Inl NModExpr then Inl (l,"Expected a module expression non-terminal")
      else case args of [p] => fmap (fn x => Inl x) (ptree_ModulePath p)
      | [s,e] => bind (check_tokens [(s,StructT),(e,EndT)]) (fn _ => Inr (Inr []))
      | [s,its,e] => bind (check_tokens [(s,StructT),(e,EndT)])
          (fn _ => fmap (fn ds => Inr ds) (ptree_ModuleItems its))
      | _ => Inl (l,"Impossible: nModExpr")
  and ptree_ModuleItems pt = case pt of Lf (_,l) => Inl (l,"Expected a module item list non-terminal")
    | Nd (n,l) args => if n <> Inl NModuleItems then Inl (l,"Expected a module item list non-terminal")
      else case args of [a] => ptree_ExprOrDefn a
      | [a,b] => bind (ptree_ExprOrDefn a) (fn d =>
          choice (fmap (fn ds => d @ ds) (ptree_ModuleItem b))
            (fn _ => fmap (fn _ => d) (ptree_Semis b)))
      | [a,b,s] => bind (ptree_ExprOrDefn a) (fn d => bind (ptree_ModuleItem b)
          (fn ds => fmap (fn _ => d @ ds) (ptree_Semis s)))
      | _ => Inl (l,"Impossible: nModuleItems")
  and ptree_ModuleItem pt = case pt of Lf (_,l) => Inl (l,"Expected a module item non-terminal")
    | Nd (n,l) args => if n <> Inl NModuleItem then Inl (l,"Expected a module item non-terminal")
      else case args of [a] => ptree_ExprOrDefn a
      | [a,b] => bind (ptree_ExprOrDefn a) (fn d => fmap (fn ds => d @ ds) (ptree_ModuleItem b))
      | _ => Inl (l,"Impossible: nModuleItem")
  and ptree_ExprOrDefn pt = case pt of Lf (_,l) => Inl (l,"Expected a top-level expression/definition non-terminal")
    | Nd (n,l) args => case n of
        Inl NExprItems => (case args of [e] => ptree_ExprDec l e
          | [s,e] => bind (ptree_Semis s) (fn _ => ptree_ExprDec l e)
          | _ => Inl (l,"Impossible: nExprItems"))
      | Inl NExprItem => (case args of [s,e] => bind (ptree_Semis s) (fn _ => ptree_ExprDec l e)
          | _ => Inl (l,"Impossible: nExprItem"))
      | Inl NDefItem => (case args of [d] => ptree_Definition d
          | [s,d] => bind (ptree_Semis s) (fn _ => ptree_Definition d)
          | _ => Inl (l,"Impossible: nExprItem"))
      | _ => Inl (l,"Expected a top-level expression/definition non-terminal");
  fun ptree_Start pt = case pt of Lf (_,l) => Inl (l,"Expected the start non-terminal")
    | Nd (n,l) args => if n <> Inl NStart then Inl (l,"Expected the start non-terminal")
      else case args of [] => Inr [] | [its] => ptree_ModuleItems its
      | _ => Inl (l,"Impossible: nStart");
end;

in

(*
  CandleParser.parse, the string entry point of the parser: Ast declarations
  or a located error, with no I/O or state.
*)
structure CandleParser = struct
  open CandleLocation;
  fun parse input = case CandleFrontEnd.parse_tree input of
      Inl error => Inl error
    | Inr [pt] => CandleDeclarations.ptree_Start pt
    | Inr _ => Inl (CandleSupport.unknown_loc,"Impossible: run_parser");
end;

end;

(*
  Candle REPL startup after the parser: CakeML-syntax bindings that the
  Candle prelude needs, error reporting for CandleParser, and the switch to
  reading candle_boot.ml through CandleParser.
*)

(* TODO: the Candle parser cannot read ~ (as in Int.~), so these bindings,
   which the prelude in candle_boot.ml uses, are written here in CakeML
   syntax. Once the parser accepts ~, move them into candle_boot.ml. *)
val negint = Int.~;
val negfloat = Double.~;
val rat_minus = Rat.~;

(* Candle syntax rejects a module name with a capital after its first letter
   (CandleBoot.parse does not parse), hence the Text_io-style name. *)
structure Candle_boot = struct
  local
    (* compilerTheory.locs_to_string and its helpers, for CandleParser
       locations. Positions are nonnegative; subtraction saturates at 0. *)
    fun nsub a b = if a < b then 0 else a - b;
    fun find_next_newline n s =
      if String.size s <= n then n
      else if String.sub s n = #"\n" then n
      else find_next_newline (n + 1) s;
    fun safe_substring s n len =
      let val size = String.size s in
        if size <= n then ""
        else if n + len <= size then String.substring s n len
        else String.substring s n (size - n)
      end;
    fun get_nth_line row s n =
      if row = 0 then safe_substring s n (nsub (find_next_newline n s) n)
      else get_nth_line (row - 1) s (find_next_newline n s + 1);
    fun copies n s =
      let fun loop k acc = if k <= 0 then acc else loop (k - 1) (s::acc)
      in loop n [] end;
    fun locs_to_string source loc = case loc of
        CandleParser.Locs (CandleParser.Posn row col) finish =>
          let val line = get_nth_line row source 0
              val stop = case finish of
                  CandleParser.Posn last_row last_col =>
                    if last_row = row then last_col else String.size line
                | _ => String.size line
              val underline = String.concat
                (copies col " " @ copies (nsub stop col + 1) "^")
          in String.concat ["line ", Int.toString (row + 1), "\n\n",
              line, "\n", underline, "\n"] end
      | _ => "unknown location";
  in
    (* Parses Candle source text. A failure is printed in the compiler's
       format and gives None. *)
    fun parse text =
      (case CandleParser.parse text of
         Inr decs => Some decs
       | Inl (loc, message) =>
           (print (message ^ "\nParsing failed at " ^
                   locs_to_string text loc ^ "\n");
            None))
      handle _ => (print "Parsing failed: the Candle parser raised an exception\n";
                   None);
  end
end;

(* The next input is candle_boot.ml, parsed by CandleParser. The callback
   first replaces itself, so a failure while booting ends the session instead
   of re-reading the file. candle_boot.ml installs the Candle reader. *)
val _ = Repl.readNextString := (fn () =>
  let
    val _ = Repl.readNextString := (fn () => Repl.isEOF := True)
    val text = String.implode (Repl.charsFrom "candle_boot.ml")
  in
    case Candle_boot.parse text of
      Some decs => (Repl.isEOF := False; Repl.nextInput := Inr decs)
    | None => Repl.isEOF := True
  end);
