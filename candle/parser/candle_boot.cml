(Inl NEFunction,rule_NEFunction ()),
(Inl NETry,rule_NETry ()),
(Inl NEWhile,rule_NEWhile ()),
(Inl NEFor,rule_NEFor ()),
(Inl NENeg,rule_NENeg ()),
(Inl NShiftOp,rule_NShiftOp ()),
(Inl NEShift,rule_NEShift ()),
(Inl NMultOp,rule_NMultOp ()),
(Inl NEMult,rule_NEMult ()),
