(*
  The PEG rule table of Candle's grammar, one rule per nonterminal NFoo.
  Choices are tried in the order listed.
*)
structure CandleGrammar = struct
  open CandleGrammarSupport;
  datatype nonterm =
      NEHolInfix | NHolInfixOp | NValuePath | NValueName | NConstr
    | NConstrName | NTypeConstr | NTypeConstrName | NModulePath | NModuleName
    | NModTypePath | NModTypeName | NFieldName | NOperatorName | NLiteral
    | NIdent | NEBase | NEList | NEApp | NEConstr | NEFunapp | NEAssert
    | NELazy | NEPrefix | NEIndex | NENeg | NEShift | NEMult | NERecProj
    | NERecUpdate | NERecCons | NEAdd | NECons | NECat | NERel | NEAnd | NEOr
    | NEProd | NEAssign | NEIf | NESeq | NEMatch | NETry | NEFun | NEFunction
    | NELet | NELetRec | NEWhile | NEFor | NExpr | NEUnclosed | NArrIdx
    | NStrIdx | NUpdate | NUpdates | NFieldDec | NFieldDecs | NLetBinding
    | NLetBindings | NLetRecBinding | NLetRecBindings | NPatternMatch
    | NPatternMatches | NTypeDefinition | NTypeDef | NTypeDefs | NTypeParams
    | NTypeInfo | NTypeRepr | NTypeReprs | NConstrDecl | NConstrArgs | NRecord
    | NExcDefinition | NPAny | NPList | NPPar | NPBase | NPRecFields | NPCons
    | NPAs | NPOps | NPattern | NPatterns | NTypeList | NTypeLists | NTVar
    | NTBase | NTConstr | NTProd | NTFun | NType | NSigSpec | NSigItems
    | NSigItem | NModTypeAssign | NModTypeAsc | NModAscApp | NModAscApps
    | NValType | NExcType | NModuleTypeDef | NIncludeMod | NOpenMod
    | NDefinition | NTopLet | NTopLetRec | NModuleItem | NModuleItems | NOpen
    | NModExpr | NModuleDef | NModuleType | NSemis | NExprItem | NExprItems
    | NDefItem | NShiftOp | NMultOp | NAddOp | NRelOp | NAndOp | NOrOp
    | NCatOp | NPrefixOp | NAssignOp | NPatLiteral | NStart | NCakeMLPragma;
  type rule = (CandleTokens.token,(nonterm,int) sum,
    (CandleTokens.token,nonterm) CandleTree.tree list,string) CandlePeg.symbol;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NCakeMLPragma u : rule =
       pegf (tokPragma ()) (bindNT NCakeMLPragma);
  fun rule_NHolInfixOp u : rule =
       pegf (choicel [tokeq FuncompT, tokeq F_FT, tokeq THEN_T, tokeq THENC_T,
                      tokeq THENL_T, tokeq THEN_TCL_T, tokeq ORELSE_T,
                      tokeq ORELSEC_T, tokeq ORELSE_TCL_T])
            (bindNT NHolInfixOp);
  fun rule_NValueName u : rule =
       choicel [pegf (tokIdP (identMixed)) (bindNT NValueName),
                seql [tokeq LparT, pnt NOperatorName, tokeq RparT]
                     (bindNT NValueName)];
  fun rule_NOperatorName u : rule =
       pegf (choicel [pnt NShiftOp,
                      pnt NMultOp,
                      pnt NAddOp,
                      pnt NRelOp,
                      pnt NAndOp,
                      pnt NOrOp,
                      pnt NHolInfixOp,
                      pnt NCatOp,
                      pnt NPrefixOp,
                      pnt NAssignOp ])
            (bindNT NOperatorName);
  fun rule_NConstrName u : rule =
       pegf (tokIdP (identUpperLower)) (bindNT NConstrName);
  fun rule_NTypeConstrName u : rule =
       pegf (tokIdP (identLower)) (bindNT NTypeConstrName);
  fun rule_NModuleName u : rule =
       pegf (tokIdP (identUpperLower)) (bindNT NModuleName);
  fun rule_NFieldName u : rule =
       pegf (tokIdP (identLower)) (bindNT NFieldName);
  fun rule_NValuePath u : rule =
       seql [try (seql [pnt NModulePath, tokeq DotT] identity), pnt NValueName]
            (bindNT NValuePath);
  fun rule_NConstr u : rule =
       pegf (choicel [seql [pnt NModuleName, tokeq DotT, pnt NConstr] identity,
                      pnt NConstrName])
            (bindNT NConstr);
  fun rule_NTypeConstr u : rule =
       seql [try (seql [pnt NModulePath, tokeq DotT] identity), pnt NTypeConstrName]
            (bindNT NTypeConstr);
  fun rule_NModulePath u : rule =
       seql [pnt NModuleName, try (seql [tokeq DotT, pnt NModulePath] identity)]
            (bindNT NModulePath);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NCakeMLPragma,rule_NCakeMLPragma ()),
(Inl NHolInfixOp,rule_NHolInfixOp ()),
(Inl NValueName,rule_NValueName ()),
(Inl NOperatorName,rule_NOperatorName ()),
(Inl NConstrName,rule_NConstrName ()),
(Inl NTypeConstrName,rule_NTypeConstrName ()),
(Inl NModuleName,rule_NModuleName ()),
(Inl NFieldName,rule_NFieldName ()),
(Inl NValuePath,rule_NValuePath ()),
(Inl NConstr,rule_NConstr ()),
(Inl NTypeConstr,rule_NTypeConstr ()),
(Inl NModulePath,rule_NModulePath ())
  ];
  in
  fun chunk_0 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NModTypeName u : rule =
       pegf (tokIdP (fn x => True)) (bindNT NModTypeName);
  fun rule_NModTypePath u : rule =
       pegf (choicel [seql [pnt NModuleName, tokeq DotT, pnt NModTypePath] identity,
                      pnt NModTypeName])
            (bindNT NModTypePath);
  fun rule_NSemis u : rule =
       seql [tokeq SemisT, try (pnt NSemis)]
            (bindNT NSemis);
  fun rule_NExprItems u : rule =
       seql [try (pnt NSemis), pnt NExpr]
            (bindNT NExprItems);
  fun rule_NExprItem u : rule =
       seql [pnt NSemis, pnt NExpr]
            (bindNT NExprItem);
  fun rule_NDefItem u : rule =
       seql [try (pnt NSemis), pnt NDefinition]
            (bindNT NDefItem);
  fun rule_NModuleItems u : rule =
       seql [choicel [pnt NExprItems, pnt NDefItem],
             try (pnt NModuleItem),
             try (pnt NSemis)]
            (bindNT NModuleItems);
  fun rule_NModuleItem u : rule =
       seql [choicel [pnt NExprItem, pnt NDefItem],
             try (pnt NModuleItem)]
            (bindNT NModuleItem);
  fun rule_NTopLet u : rule =
       seql [tokeq LetT, pnt NLetBindings]
            (bindNT NTopLet);
  fun rule_NTopLetRec u : rule =
       seql [tokeq LetT, tokeq RecT, pnt NLetRecBindings]
            (bindNT NTopLetRec);
  fun rule_NOpen u : rule =
       seql [tokeq OpenT, pnt NModulePath]
            (bindNT NOpen);
  fun rule_NModExpr u : rule =
       pegf (choicel [pnt NModulePath,
                      seql [tokeq StructT, try (pnt NModuleItems), tokeq EndT] identity])
            (bindNT NModExpr);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NModTypeName,rule_NModTypeName ()),
(Inl NModTypePath,rule_NModTypePath ()),
(Inl NSemis,rule_NSemis ()),
(Inl NExprItems,rule_NExprItems ()),
(Inl NExprItem,rule_NExprItem ()),
(Inl NDefItem,rule_NDefItem ()),
(Inl NModuleItems,rule_NModuleItems ()),
(Inl NModuleItem,rule_NModuleItem ()),
(Inl NTopLet,rule_NTopLet ()),
(Inl NTopLetRec,rule_NTopLetRec ()),
(Inl NOpen,rule_NOpen ()),
(Inl NModExpr,rule_NModExpr ())
  ];
  in
  fun chunk_1 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NModuleDef u : rule =
       seql [tokeq ModuleT, pnt NModuleName,
             try (seql [tokeq ColonT, pnt NModuleType] identity),
             tokeq EqualT, pnt NModExpr]
            (bindNT NModuleDef);
  fun rule_NDefinition u : rule =
       pegf (choicel [pnt NTopLetRec,
                      pnt NTopLet,
                      pnt NTypeDefinition,
                      pnt NExcDefinition,
                      pnt NOpen,
                      pnt NModuleTypeDef,
                      pnt NModuleDef,

                      pnt NCakeMLPragma])
            (bindNT NDefinition);
  fun rule_NExcType u : rule =
       seql [tokeq ExceptionT, pnt NConstrDecl]
            (bindNT NExcType);
  fun rule_NValType u : rule =
       seql [tokeq ValT, pnt NValueName, tokeq ColonT, pnt NType]
            (bindNT NValType);
  fun rule_NModAscApp u : rule =
       seql [tokeq LparT, pnt NModuleName, tokeq ColonT,
             pnt NModuleType, tokeq RparT]
            (bindNT NModAscApp);
  fun rule_NModAscApps u : rule =
       seql [pnt NModAscApp, try (pnt NModAscApps)]
            (bindNT NModAscApps);
  fun rule_NModTypeAsc u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModuleName,
             try (pnt NModAscApps),
             tokeq ColonT, pnt NModuleType]
            (bindNT NModTypeAsc);
  fun rule_NModTypeAssign u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModTypeName,
             try (seql [tokeq EqualT, pnt NModuleType] identity)]
            (bindNT NModTypeAssign);
  fun rule_NOpenMod u : rule =
       seql [tokeq OpenT, pnt NModulePath]
            (bindNT NOpenMod);
  fun rule_NIncludeMod u : rule =
       seql [tokeq IncludeT, pnt NModulePath]
            (bindNT NIncludeMod);
  fun rule_NSigItem u : rule =
       pegf (choicel [pnt NTypeDefinition,
                      pnt NExcType,
                      pnt NValType,
                      pnt NModTypeAsc,
                      pnt NModTypeAssign,
                      pnt NOpenMod,
                      pnt NIncludeMod])
            (bindNT NSigItem);
  fun rule_NSigItems u : rule =
       seql [pnt NSigItem, try (pnt NSemis), try (pnt NSigItems)]
            (bindNT NSigItems);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NModuleDef,rule_NModuleDef ()),
(Inl NDefinition,rule_NDefinition ()),
(Inl NExcType,rule_NExcType ()),
(Inl NValType,rule_NValType ()),
(Inl NModAscApp,rule_NModAscApp ()),
(Inl NModAscApps,rule_NModAscApps ()),
(Inl NModTypeAsc,rule_NModTypeAsc ()),
(Inl NModTypeAssign,rule_NModTypeAssign ()),
(Inl NOpenMod,rule_NOpenMod ()),
(Inl NIncludeMod,rule_NIncludeMod ()),
(Inl NSigItem,rule_NSigItem ()),
(Inl NSigItems,rule_NSigItems ())
  ];
  in
  fun chunk_2 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NSigSpec u : rule =
       seql [tokeq SigT, try (pnt NSigItems), tokeq EndT]
            (bindNT NSigSpec);
  fun rule_NModuleType u : rule =
       pegf (choicel [pnt NModTypePath,
                      pnt NSigSpec,
                      seql [tokeq LparT, pnt NModuleType, tokeq RparT] identity])
            (bindNT NModuleType);
  fun rule_NModuleTypeDef u : rule =
       seql [tokeq ModuleT, tokeq TypeT, pnt NModTypeName, tokeq EqualT,
             pnt NModuleType]
            (bindNT NModuleTypeDef);
  fun rule_NExcDefinition u : rule =
       seql [tokeq ExceptionT,
             choicel [seql [pnt NConstrName, tokeq EqualT, pnt NConstr] identity,
                      pnt NConstrDecl]]
            (bindNT NExcDefinition);
  fun rule_NTypeDefinition u : rule =
       seql [tokeq TypeT, try (tokeq NonrecT), pnt NTypeDefs]
            (bindNT NTypeDefinition);
  fun rule_NTypeDef u : rule =
       seql [try (pnt NTypeParams), pnt NTypeConstrName,
             try (pnt NTypeInfo)]
            (bindNT NTypeDef);
  fun rule_NTypeDefs u : rule =
       seql [pnt NTypeDef, try (seql [tokeq AndT, pnt NTypeDefs] identity)]
            (bindNT NTypeDefs);
  fun rule_NTypeParams u : rule =
       choicel [pegf (pnt NTVar) (bindNT NTypeParams),
                seql [tokeq LparT, pnt NTVar,
                      rpt (seql [tokeq CommaT, pnt NTVar] identity) List.concat,
                      tokeq RparT]
                     (bindNT NTypeParams)];
  fun rule_NTypeInfo u : rule =
       seql [tokeq EqualT,
             choicel [pnt NType, pnt NTypeRepr]]
            (bindNT NTypeInfo);
  fun rule_NTypeRepr u : rule =
       seql [try (tokeq BarT), pnt NConstrDecl, try (pnt NTypeReprs)]
            (bindNT NTypeRepr);
  fun rule_NTypeReprs u : rule =
       seql [tokeq BarT, pnt NConstrDecl, try (pnt NTypeReprs)]
            (bindNT NTypeReprs);
  fun rule_NConstrDecl u : rule =
       seql [pnt NConstrName,
             try (seql [tokeq OfT, choicel [pnt NConstrArgs, pnt NRecord]] identity)]
            (bindNT NConstrDecl);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NSigSpec,rule_NSigSpec ()),
(Inl NModuleType,rule_NModuleType ()),
(Inl NModuleTypeDef,rule_NModuleTypeDef ()),
(Inl NExcDefinition,rule_NExcDefinition ()),
(Inl NTypeDefinition,rule_NTypeDefinition ()),
(Inl NTypeDef,rule_NTypeDef ()),
(Inl NTypeDefs,rule_NTypeDefs ()),
(Inl NTypeParams,rule_NTypeParams ()),
(Inl NTypeInfo,rule_NTypeInfo ()),
(Inl NTypeRepr,rule_NTypeRepr ()),
(Inl NTypeReprs,rule_NTypeReprs ()),
(Inl NConstrDecl,rule_NConstrDecl ())
  ];
  in
  fun chunk_3 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NRecord u : rule =
       seql [tokeq LbraceT, pnt NFieldDecs, try (tokeq SemiT), tokeq RbraceT]
            (bindNT NRecord);
  fun rule_NFieldDecs u : rule =
       seql [pnt NFieldDec, try (seql [tokeq SemiT, pnt NFieldDecs] identity)]
            (bindNT NFieldDecs);
  fun rule_NFieldDec u : rule =
       seql [pnt NFieldName, tokeq ColonT, pnt NType]
            (bindNT NFieldDec);
  fun rule_NConstrArgs u : rule =
       seql [pnt NTConstr, rpt (seql [tokeq StarT, pnt NTConstr] identity) List.concat]
            (bindNT NConstrArgs);
  fun rule_NTypeList u : rule =
       seql [pnt NType, tokeq CommaT, pnt NTypeLists]
            (bindNT NTypeList);
  fun rule_NTypeLists u : rule =
       seql [pnt NType, try (seql [tokeq CommaT, pnt NTypeLists] identity)]
            (bindNT NTypeLists);
  fun rule_NTVar u : rule =
       seql [tokeq TickT, pnt NIdent] (bindNT NTVar);
  fun rule_NTBase u : rule =
       pegf (choicel [seql [tokeq LparT, pnt NType, tokeq RparT] identity,
                      seql [tokeq LparT, pnt NTypeList, tokeq RparT,
                            pnt NTypeConstr] identity,
                      pnt NTVar])
            (bindNT NTBase);
  fun rule_NTConstr u : rule =
       choicel [seql [try (pnt NTBase), pnt NTypeConstr,
                      rpt (pnt NTypeConstr) List.concat]
                     (bindNT NTConstr),
                pegf (pnt NTBase) (bindNT NTConstr)];
  fun rule_NTProd u : rule =
       seql [pnt NTConstr, rpt (seql [tokeq StarT, pnt NTConstr] identity) List.concat]
            (bindNT NTProd);
  fun rule_NTFun u : rule =
       seql [pnt NTProd, try (seql [tokeq RarrowT, pnt NTFun] identity)]
            (bindNT NTFun);
  fun rule_NType u : rule =
       pegf (pnt NTFun) (bindNT NType);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NRecord,rule_NRecord ()),
(Inl NFieldDecs,rule_NFieldDecs ()),
(Inl NFieldDec,rule_NFieldDec ()),
(Inl NConstrArgs,rule_NConstrArgs ()),
(Inl NTypeList,rule_NTypeList ()),
(Inl NTypeLists,rule_NTypeLists ()),
(Inl NTVar,rule_NTVar ()),
(Inl NTBase,rule_NTBase ()),
(Inl NTConstr,rule_NTConstr ()),
(Inl NTProd,rule_NTProd ()),
(Inl NTFun,rule_NTFun ()),
(Inl NType,rule_NType ())
  ];
  in
  fun chunk_4 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NEList u : rule =
       seql [tokeq LbrackT,
             try (seql [pnt NEIf,
                        rpt (seql [tokeq SemiT, pnt NEIf] identity) List.concat,
                        try (tokeq SemiT)] identity),
             tokeq RbrackT]
            (bindNT NEList);
  fun rule_NLiteral u : rule =
       choicel [
         tok isInt    (fn t => bindNT NLiteral (mktokLf t)),
         tok isString (fn t => bindNT NLiteral (mktokLf t)),
         tok isChar   (fn t => bindNT NLiteral (mktokLf t)),
         tok (fn x => x = TrueT orelse x = FalseT) (fn t => bindNT NLiteral (mktokLf t))];
  fun rule_NIdent u : rule =
       tok isIdent (fn t => bindNT NIdent (mktokLf t));
  fun rule_NUpdate u : rule =
       seql [pnt NFieldName, tokeq EqualT, pnt NEIf]
            (bindNT NUpdate);
  fun rule_NUpdates u : rule =
       seql [pnt NUpdate, try (seql [tokeq SemiT, pnt NUpdates] identity)]
            (bindNT NUpdates);
  fun rule_NERecUpdate u : rule =
       seql [pnt NConstr, tokeq LbraceT, pnt NExpr, tokeq WithT, pnt NUpdates,
             try (tokeq SemiT), tokeq RbraceT]
            (bindNT NERecUpdate);
  fun rule_NEBase u : rule =
       choicel [
         pegf (pnt NLiteral) (bindNT NEBase),
         pegf (pnt NValuePath) (bindNT NEBase),

         pegf (pnt NERecUpdate) (bindNT NEBase),
         pegf (pnt NConstr) (bindNT NEBase),
         pegf (pnt NEList) (bindNT NEBase),
         seql [tokeq LparT, tokeq RparT] (bindNT NEBase),
         seql [tokeq BeginT, tokeq EndT] (bindNT NEBase),
         seql [tokeq LparT, pnt NExpr,
               try (seql [tokeq ColonT, pnt NType] identity),
               tokeq RparT] (bindNT NEBase),
         seql [tokeq BeginT, pnt NExpr, tokeq EndT] (bindNT NEBase)
       ];
  fun rule_NPrefixOp u : rule =
       pegf (tokSymP (validPrefixSym))
            (bindNT NPrefixOp);
  fun rule_NEPrefix u : rule =
       seql [try (pnt NPrefixOp), pnt NEBase] (bindNT NEPrefix);
  fun rule_NArrIdx u : rule =
       seql [tokeq DotT, tokeq LparT, pnt NExpr, tokeq RparT]
            (bindNT NArrIdx);
  fun rule_NStrIdx u : rule =
       seql [tokeq DotT, tokeq LbrackT, pnt NExpr, tokeq RbrackT]
            (bindNT NStrIdx);
  fun rule_NEIndex u : rule =
       seql [pnt NEPrefix, try (choicel [pnt NStrIdx, pnt NArrIdx])]
            (bindNT NEIndex);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NEList,rule_NEList ()),
(Inl NLiteral,rule_NLiteral ()),
(Inl NIdent,rule_NIdent ()),
(Inl NUpdate,rule_NUpdate ()),
(Inl NUpdates,rule_NUpdates ()),
(Inl NERecUpdate,rule_NERecUpdate ()),
(Inl NEBase,rule_NEBase ()),
(Inl NPrefixOp,rule_NPrefixOp ()),
(Inl NEPrefix,rule_NEPrefix ()),
(Inl NArrIdx,rule_NArrIdx ()),
(Inl NStrIdx,rule_NStrIdx ()),
(Inl NEIndex,rule_NEIndex ())
  ];
  in
  fun chunk_5 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NERecProj u : rule =
       seql [pnt NEIndex,
             try (seql [tokeq DotT, pnt NConstr, tokeq DotT, pnt NFieldName] identity)]
            (bindNT NERecProj);
  fun rule_NEAssert u : rule =
       seql [tokeq AssertT, pnt NERecProj] (bindNT NEAssert);
  fun rule_NELazy u : rule =
       seql [tokeq LazyT, pnt NERecProj] (bindNT NELazy);
  fun rule_NEConstr u : rule =
       seql [pnt NConstr, pnt NERecProj] (bindNT NEConstr);
  fun rule_NERecCons u : rule =
       seql [pnt NConstr,
             tokeq LbraceT, pnt NUpdates, try (tokeq SemiT), tokeq RbraceT]
            (bindNT NERecCons);
  fun rule_NEFunapp u : rule =
       seql [pnt NERecProj, rpt (pnt NERecProj) List.concat]
            (fn l => case l of
                   [] => []
                 | h::t => [foldl (fn a => fn b => mkNd (Inl NEFunapp) [a, b])
                                  (mkNd (Inl NEFunapp) [h]) t]);
  fun rule_NEApp u : rule =
       pegf (choicel (List.map pnt [NELazy, NEAssert, NERecCons, NEConstr, NEFunapp,
                               NERecProj]))
            (bindNT NEApp);
  fun rule_NEUnclosed u : rule =
       pegf (choicel [
               pnt NELetRec, pnt NELet, pnt NEMatch, pnt NEFun, pnt NEFunction,
               pnt NETry, pnt NEWhile, pnt NEFor, pnt NEApp])
            (bindNT NEUnclosed);
  fun rule_NELetRec u : rule =
       seql [tokeq LetT, tokeq RecT, pnt NLetRecBindings,
             tokeq InT, pnt NExpr]
            (bindNT NELetRec);
  fun rule_NELet u : rule =
       seql [tokeq LetT, pnt NLetBindings,
             tokeq InT, pnt NExpr]
            (bindNT NELet);
  fun rule_NEMatch u : rule =
       seql [tokeq MatchT, pnt NExpr, tokeq WithT, pnt NPatternMatch]
            (bindNT NEMatch);
  fun rule_NEFun u : rule =
       seql [tokeq FunT, pnt NPatterns,
             try (seql [tokeq ColonT, pnt NType] identity),
             tokeq RarrowT, pnt NExpr]
            (bindNT NEFun);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NERecProj,rule_NERecProj ()),
(Inl NEAssert,rule_NEAssert ()),
(Inl NELazy,rule_NELazy ()),
(Inl NEConstr,rule_NEConstr ()),
(Inl NERecCons,rule_NERecCons ()),
(Inl NEFunapp,rule_NEFunapp ()),
(Inl NEApp,rule_NEApp ()),
(Inl NEUnclosed,rule_NEUnclosed ()),
(Inl NELetRec,rule_NELetRec ()),
(Inl NELet,rule_NELet ()),
(Inl NEMatch,rule_NEMatch ()),
(Inl NEFun,rule_NEFun ())
  ];
  in
  fun chunk_6 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NEFunction u : rule =
       seql [tokeq FunctionT, pnt NPatternMatch]
            (bindNT NEFunction);
  fun rule_NETry u : rule =
       seql [tokeq TryT, pnt NExpr, tokeq WithT, pnt NPatternMatch]
            (bindNT NETry);
  fun rule_NEWhile u : rule =
       seql [tokeq WhileT, pnt NExpr, tokeq DoT, pnt NExpr, tokeq DoneT]
            (bindNT NEWhile);
  fun rule_NEFor u : rule =
       seql [tokeq ForT, pnt NValueName, tokeq EqualT, pnt NExpr,
             choicel [tokeq ToT, tokeq DowntoT], pnt NExpr,
             tokeq DoT, pnt NExpr, tokeq DoneT]
            (bindNT NEFor);
  fun rule_NENeg u : rule =
       seql [try (choicel [tokeq MinusT, tokeq MinusFT]),

             pnt NEUnclosed]
            (bindNT NENeg);
  fun rule_NShiftOp u : rule =
       pegf (choicel [tokSymP (validShiftOp), tokeq LslT, tokeq LsrT, tokeq AsrT])
            (bindNT NShiftOp);
  fun rule_NEShift u : rule =
       seql [pnt NENeg, try (seql [pnt NShiftOp, pnt NEShift] identity)]
            (bindNT NEShift);
  fun rule_NMultOp u : rule =
       pegf (choicel [tokeq StarT, tokeq ModT, tokeq LandT, tokeq LorT,
                      tokeq LxorT, tokSymP (validMultOp)])
            (bindNT NMultOp);
