  fun chunk_6 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NEFunction u : rule =
       seql [tokeq FunctionT, pnt NPatternMatch]
            (bindNT NEFunction);
  fun rule_NETry u : rule =
       seql [tokeq TryT, pnt NExpr, tokeq WithT, pnt NPatternMatch]
            (bindNT NETry);
  fun rule_NEWhile u : rule =
       seql [tokeq WhileT, pnt NExpr, tokeq DoT, pnt NExpr, tokeq DoneT]
            (bindNT NEWhile);
  fun rule_NEFor u : rule =
       seql [tokeq ForT, pnt NValueName, tokeq EqualT, pnt NExpr,
             choicel [tokeq ToT, tokeq DowntoT], pnt NExpr,
             tokeq DoT, pnt NExpr, tokeq DoneT]
            (bindNT NEFor);
  fun rule_NENeg u : rule =
       seql [try (choicel [tokeq MinusT, tokeq MinusFT]),
             pnt NEUnclosed]
            (bindNT NENeg);
  fun rule_NShiftOp u : rule =
       pegf (choicel [tokSymP "an operator" validShiftOp, tokeq LslT, tokeq LsrT, tokeq AsrT])
            (bindNT NShiftOp);
  fun rule_NEShift u : rule =
       seql [pnt NENeg, try (seql [pnt NShiftOp, pnt NEShift] identity)]
            (bindNT NEShift);
  fun rule_NMultOp u : rule =
       pegf (choicel [tokeq StarT, tokeq ModT, tokeq LandT, tokeq LorT,
                      tokeq LxorT, tokSymP "an operator" validMultOp])
            (bindNT NMultOp);
  fun rule_NEMult u : rule =
       peg_linfix (Inl NEMult) (pnt NEShift) (pnt NMultOp);
  fun rule_NAddOp u : rule =
       pegf (choicel [tokeq PlusT, tokeq MinusT, tokeq MinusFT,
                      tokSymP "an operator" validAddOp])
            (bindNT NAddOp);
  fun rule_NEAdd u : rule =
       peg_linfix (Inl NEAdd) (pnt NEMult) (pnt NAddOp);
  fun rule_NECons u : rule =
       seql [pnt NEAdd, try (seql [tokeq ColonsT, pnt NECons] identity)]
            (bindNT NECons);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NEFunction,rule_NEFunction ()),
(Inl NETry,rule_NETry ()),
(Inl NEWhile,rule_NEWhile ()),
(Inl NEFor,rule_NEFor ()),
(Inl NENeg,rule_NENeg ()),
(Inl NShiftOp,rule_NShiftOp ()),
(Inl NEShift,rule_NEShift ()),
(Inl NMultOp,rule_NMultOp ()),
(Inl NEMult,rule_NEMult ()),
(Inl NAddOp,rule_NAddOp ()),
(Inl NEAdd,rule_NEAdd ()),
(Inl NECons,rule_NECons ())
  ];
  in
  fun chunk_7 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NCatOp u : rule =
       pegf (tokSymP "an operator" validCatOp)
            (bindNT NCatOp);
  fun rule_NECat u : rule =
       seql [pnt NECons, try (seql [pnt NCatOp, pnt NECat] identity)]
            (bindNT NECat);
  fun rule_NRelOp u : rule =
       pegf (choicel [tokeq EqualT, tokeq LessT, tokeq GreaterT, tokeq NeqT,
                      tokSymP "an operator" validRelOp])
            (bindNT NRelOp);
  fun rule_NERel u : rule =
       peg_linfix (Inl NERel) (pnt NECat) (pnt NRelOp);
  fun rule_NAndOp u : rule =
       pegf (choicel [tokeq AmpT, tokeq AndalsoT])
            (bindNT NAndOp);
  fun rule_NEAnd u : rule =
       seql [pnt NERel, try (seql [pnt NAndOp, pnt NEAnd] identity)]
            (bindNT NEAnd);
  fun rule_NOrOp u : rule =
       pegf (choicel [tokeq OrelseT, tokeq OrT])
            (bindNT NOrOp);
  fun rule_NEOr u : rule =
       seql [pnt NEAnd, try (seql [pnt NOrOp, pnt NEOr] identity)]
            (bindNT NEOr);
  fun rule_NEHolInfix u : rule =
       peg_linfix (Inl NEHolInfix) (pnt NEOr) (pnt NHolInfixOp);
  fun rule_NEProd u : rule =
       seql [pnt NEHolInfix,
             rpt (seql [tokeq CommaT, pnt NEHolInfix] identity) List.concat]
            (bindNT NEProd);
  fun rule_NAssignOp u : rule =
       pegf (choicel [tokeq UpdateT, tokeq LarrowT])
            (bindNT NAssignOp);
  fun rule_NEAssign u : rule =
       seql [pnt NEProd, try (seql [pnt NAssignOp, pnt NEAssign] identity)]
            (bindNT NEAssign);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NCatOp,rule_NCatOp ()),
(Inl NECat,rule_NECat ()),
(Inl NRelOp,rule_NRelOp ()),
(Inl NERel,rule_NERel ()),
(Inl NAndOp,rule_NAndOp ()),
(Inl NEAnd,rule_NEAnd ()),
(Inl NOrOp,rule_NOrOp ()),
(Inl NEOr,rule_NEOr ()),
(Inl NEHolInfix,rule_NEHolInfix ()),
(Inl NEProd,rule_NEProd ()),
(Inl NAssignOp,rule_NAssignOp ()),
(Inl NEAssign,rule_NEAssign ())
  ];
  in
  fun chunk_8 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NEIf u : rule =
       pegf (choicel [seql [tokeq IfT, pnt NExpr, tokeq ThenT, pnt NEIf,
                            try (seql [tokeq ElseT, pnt NEIf] identity)] identity,
                      pnt NEAssign])
            (bindNT NEIf);
  fun rule_NESeq u : rule =
       seql [pnt NEIf, try (seql [tokeq SemiT, pnt NExpr] identity)]
            (bindNT NESeq);
  fun rule_NExpr u : rule =
       pegf (choicel [pnt NESeq])
            (bindNT NExpr);
  fun rule_NPatternMatch u : rule =
       seql [try (tokeq BarT), pnt NPatternMatches]
            (bindNT NPatternMatch);
  fun rule_NPatternMatches u : rule =
       seql [pnt NPattern,
             try (seql [tokeq WhenT, pnt NExpr] identity),
             tokeq RarrowT, pnt NExpr,
             try (seql [tokeq BarT, pnt NPatternMatches] identity)]
            (bindNT NPatternMatches);
  fun rule_NLetRecBinding u : rule =
       seql [pnt NValueName,
             try (pnt NPatterns),
             try (seql [tokeq ColonT, pnt NType] identity),
             tokeq EqualT, pnt NExpr]
            (bindNT NLetRecBinding);
  fun rule_NLetRecBindings u : rule =
       seql [pnt NLetRecBinding, try (seql [tokeq AndT, pnt NLetRecBindings] identity)]
            (bindNT NLetRecBindings);
  fun rule_NLetBinding u : rule =
       pegf (choicel [seql [pnt NPattern, tokeq EqualT, pnt NExpr] identity,
                      seql [pnt NValueName, try (pnt NPatterns),
                            try (seql [tokeq ColonT, pnt NType] identity),
                            tokeq EqualT, pnt NExpr] identity])
            (bindNT NLetBinding);
  fun rule_NLetBindings u : rule =
       seql [pnt NLetBinding, try (seql [tokeq AndT, pnt NLetBindings] identity)]
            (bindNT NLetBindings);
  fun rule_NPAny u : rule =
       pegf (tokeq AnyT) (bindNT NPAny);
  fun rule_NPList u : rule =
       seql [tokeq LbrackT,
             rpt (seql [pnt NPattern, tokeq SemiT] identity) List.concat, try (pnt NPattern),
             tokeq RbrackT]
            (bindNT NPList);
  fun rule_NPPar u : rule =
       seql [tokeq LparT,
             try (seql [pnt NPattern,
                        try (seql [tokeq ColonT, pnt NType] identity)] identity),
             tokeq RparT]
            (bindNT NPPar);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NEIf,rule_NEIf ()),
(Inl NESeq,rule_NESeq ()),
(Inl NExpr,rule_NExpr ()),
(Inl NPatternMatch,rule_NPatternMatch ()),
(Inl NPatternMatches,rule_NPatternMatches ()),
(Inl NLetRecBinding,rule_NLetRecBinding ()),
(Inl NLetRecBindings,rule_NLetRecBindings ()),
(Inl NLetBinding,rule_NLetBinding ()),
(Inl NLetBindings,rule_NLetBindings ()),
(Inl NPAny,rule_NPAny ()),
(Inl NPList,rule_NPList ()),
(Inl NPPar,rule_NPPar ())
  ];
  in
  fun chunk_9 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  fun rule_NPatLiteral u : rule =
       choicel [pegf (pnt NLiteral) (bindNT NPatLiteral),
                seql [tokeq MinusT, tok ["an integer"] isInt mktokLf]
                     (bindNT NPatLiteral)];
  fun rule_NPBase u : rule =
       pegf (choicel [pnt NPatLiteral, pnt NValueName, pnt NPAny, pnt NPList,
                      pnt NPPar, pnt NConstr])
            (bindNT NPBase);
  fun rule_NPRecFields u : rule =
       seql [tokeq LbraceT,
             pnt NFieldName,
             rpt (seql [tokeq SemiT, pnt NFieldName] identity) List.concat,
             try (tokeq SemiT),
             tokeq RbraceT]
            (bindNT NPRecFields);
  fun rule_NPCons u : rule =
       pegf (choicel [seql [pnt NConstr,
                            choicel [pnt NPRecFields, pnt NPBase]] identity,
                      pnt NPBase])
            (bindNT NPCons);
  fun rule_NPAs u : rule =
       seql [pnt NPCons, rpt (seql [tokeq AsT, pnt NIdent] identity) List.concat]
            (bindNT NPAs);
  fun rule_NPOps u : rule =
       seql [pnt NPAs, rpt (seql [tok (List.map describe_token [ColonsT, CommaT, BarT])
                                      (fn t => t = ColonsT orelse t = CommaT orelse t = BarT)
                                      mktokLf, pnt NPAs] identity) List.concat]
            (bindNT NPOps);
  fun rule_NPattern u : rule =
       pegf (pnt NPOps) (bindNT NPattern);
  fun rule_NPatterns u : rule =
       seql [pnt NPBase, try (pnt NPatterns)]
            (bindNT NPatterns);
  fun rule_NStart u : rule =
       seql [try (pnt NModuleItems)] (bindNT NStart);
  val rules : ((nonterm,int) sum * rule) list = [
(Inl NPatLiteral,rule_NPatLiteral ()),
(Inl NPBase,rule_NPBase ()),
(Inl NPRecFields,rule_NPRecFields ()),
(Inl NPCons,rule_NPCons ()),
(Inl NPAs,rule_NPAs ()),
(Inl NPOps,rule_NPOps ()),
(Inl NPattern,rule_NPattern ()),
(Inl NPatterns,rule_NPatterns ()),
(Inl NStart,rule_NStart ())
  ];
  in
  fun chunk_10 u = rules;
  end;
end;
structure CandleGrammar = struct
  open CandleGrammar;
  local
  val rule_list = List.concat [chunk_0 (),chunk_1 (),chunk_2 (),chunk_3 (),chunk_4 (),chunk_5 (),chunk_6 (),chunk_7 (),chunk_8 (),chunk_9 (),chunk_10 ()];
  val rule_vector =
    Vector.fromList (List.map (fn n => Alist.lookup rule_list (Inl n)) nonterms);
  fun lookup i = Vector.sub rule_vector i;
  (* What error messages call these nonterminals: what was expected where one
     of them started is reported as its label. *)
  val label_list =
    List.map (fn n => (n,"an expression"))
      [NExpr, NESeq, NEIf, NEAssign, NEProd, NEHolInfix, NEOr, NEAnd, NERel,
       NECat, NECons, NEAdd, NEMult, NEShift, NENeg, NEUnclosed, NEApp,
       NEFunapp, NEConstr, NEAssert, NELazy, NERecProj, NEIndex, NEPrefix,
       NEBase, NELet, NELetRec, NEMatch, NEFun, NEFunction, NETry, NEWhile,
       NEFor, NEList, NERecUpdate, NERecCons, NLiteral] @
    List.map (fn n => (n,"an infix operator"))
      [NShiftOp, NMultOp, NAddOp, NRelOp, NAndOp, NOrOp, NHolInfixOp, NCatOp,
       NAssignOp] @
    List.map (fn n => (n,"a pattern"))
      [NPatterns, NPattern, NPOps, NPAs, NPCons, NPBase, NPatLiteral, NPAny,
       NPList, NPPar] @
    List.map (fn n => (n,"a type"))
      [NType, NTFun, NTProd, NTConstr, NTBase] @
    List.map (fn n => (n,"a definition"))
      [NDefinition, NTopLet, NTopLetRec, NTypeDefinition, NExcDefinition,
       NModuleDef, NModuleTypeDef, NOpen];
  val label_vector =
    Vector.fromList (List.map (fn n => Alist.lookup label_list n) nonterms);
  fun label i = Vector.sub label_vector i;
  val grammar = (lookup,label,"any token","Not combinator failed");
  in
  fun parse_nt n tokens = CandlePeg.execute grammar (pnt n) tokens;
  fun parse_tokens tokens = parse_nt NStart tokens;
  end;
end;
