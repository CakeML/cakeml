(*
  Parser locations, and list, character and digit helpers.
*)
structure CandleLocation = struct
  datatype locn = Posn int int | Unknownpt | Eofpt;
  datatype locs = Locs locn locn;
end;

structure CandleSupport = struct
  open CandleLocation;
  val unknown_loc = Locs Unknownpt Unknownpt;
  val init_loc = Posn 0 0;
  fun next_loc n loc =
    case loc of Posn r c => Posn r (c + n) | _ => loc;
  fun next_line loc =
    case loc of Posn r c => Posn (r + 1) 0 | _ => loc;
  fun locnle a b =
    case a of
      Unknownpt => True
    | Eofpt => (case b of Eofpt => True | _ => False)
    | Posn r c =>
        (case b of
          Eofpt => True
        | Unknownpt => False
        | Posn s d => r < s orelse (r = s andalso c <= d));
  fun locs_start l = case l of Locs p _ => p;
  fun locs_end l = case l of Locs _ q => q;
  fun locsle a b = locnle (locs_start a) (locs_start b);
  fun merge_locs a b = Locs (locs_start a) (locs_end b);
  fun merge_list_locs xs =
    case xs of
      [] => unknown_loc
    | h::_ => merge_locs h (List.last xs);
  fun nsub a b = if a < b then 0 else a - b;
  (* The longest prefix of xs whose elements satisfy p, and the rest. *)
  fun take_while p xs = List.split (fn x => not (p x)) xs;
  fun hex_digit c =
    let val n = Char.ord c in
      if 48 <= n andalso n <= 57 then n - 48 else
      if 65 <= n andalso n <= 70 then n - 55 else
      if 97 <= n andalso n <= 102 then n - 87 else 0
    end;
  fun isHexDigit c = Char.contains "0123456789ABCDEFabcdef" c;
  fun isOctDigit c = Char.contains "01234567" c;
  fun isBinDigit c = c = #"0" orelse c = #"1";
  fun from_digits base cs =
    List.foldl (fn c => fn n => n * base + (hex_digit c) mod base) 0 cs;
end;

(* Character tests over whole strings, shaped like SML's CharVector.all and
   CharVector.exists; both stop at the first character that decides. *)
structure CandleString = struct
  fun all p s =
    let val n = String.size s
        fun loop i = i >= n orelse (p (String.sub s i) andalso loop (i + 1))
    in loop 0 end;
  fun exists p s =
    let val n = String.size s
        fun loop i = i < n andalso (p (String.sub s i) orelse loop (i + 1))
    in loop 0 end;
end;
