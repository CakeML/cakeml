INCLUDES = $(CAKEMLDIR)/misc ../translation $(CAKEMLDIR)/cv_translator

all: $(DEFAULT_TARGETS) README.md caketaiger
.PHONY: all

README_SOURCES = $(wildcard *Script.sml) $(wildcard *Lib.sml) $(wildcard *Syntax.sml)
DIRS = $(wildcard */)
README.md: $(CAKEMLDIR)/developers/readme_gen readmePrefix $(patsubst %,%readmePrefix,$(DIRS)) $(README_SOURCES)
	$(CAKEMLDIR)/developers/readme_gen $(README_SOURCES)

ifdef POLY
HOLHEAP = $(CAKEMLDIR)/cv_translator/cake_compile_heap
endif

caketaiger: caketaigerCompileTheory.uo
	gcc -o caketaiger caketaiger.S $(CAKEMLDIR)/examples/cnf/basis_ffi.c
