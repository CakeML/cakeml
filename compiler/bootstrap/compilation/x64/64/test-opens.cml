(* Native regression for issue #880. Reaching the final line requires every
   assertion to have passed; a failed pattern raises Bind. *)

structure S = struct datatype foo = Foo end;
fun before_open S.Foo = 10;
open S;
fun after_open Foo = 20;
val True = before_open Foo = 10 andalso after_open S.Foo = 20;
val True = let open S fun local_match Foo = 30 in local_match Foo = 30 end;

datatype outer = C int;
val x = 1;
structure M = struct
  datatype inner = C;
  val x = 7;
  structure N = struct val x = 8 end;
end;
val True = let val x = 2 open M in x = 7 end;
val True = let open M val x = 9 in x = 9 end;
val True = x = 1;
val True = (fn unused => let open M in C end) 0 = M.C;
val C 5 = C 5;

val captured = let open M in fn (unused : int) => x end;
val captured_rec = let open M fun f (unused : int) = x in f end;
val outer_rec = let fun f (unused : int) = x open M in f end;
structure M = struct val x = 42 end;
val True = captured 0 = 7 andalso captured_rec 0 = 7 andalso outer_rec 0 = 1;

structure N = struct val x = 100 end;
structure Outer = struct
  structure N = struct val x = 11 end;
end;
val True = let open Outer.N in x = 11 end;
val True = let open Outer open N in x = 11 end;
open Outer;
open N;
val True = x = 11;

structure Shared = struct
  val r = Ref 3;
  exception Stop;
  type t = int;
end;
val alias = let open Shared in r end;
val () = alias := 4;
val True = !Shared.r = 4;
val True = ((let open Shared in raise Stop end) handle Shared.Stop => 31) = 31;
val True = let open Shared val typed = (6 : t) in typed = 6 end;

structure Poly = struct val id = fn z => z end;
val polymorphic = let open Poly in id end;
val True = polymorphic 12 = 12 andalso polymorphic #"a" = #"a";
structure EmptyOuter = struct structure N = struct end end;
val True = let open EmptyOuter open N in x = 11 end;

print "opens: ok\n";
