INCLUDES = $(HOLDIR)/examples/pl-semantics/lprefix_lub

all: $(DEFAULT_TARGETS) README.md
.PHONY: all

README_SOURCES = preamble.sml $(wildcard *Script.sml) $(wildcard *Lib.sml) $(wildcard *Syntax.sml) $(wildcard *.sh)
sinclude $(CAKEMLDIR)/developers/readme.mk

# Runs update_build_info.sh whenever Holmake reads this file, which updates
# build_info.txt if needed. On success, the script prints a non-empty string,
# so buildInfoLib.uo depends on build_info.txt. If build_info.txt changed,
# buildInfoLib.uo and everything that depends on it are rebuilt, so binaries
# don't carry out-of-date build information. See update_build_info.sh for the
# environment variable that disables these rebuilds.
buildInfoLib.uo: $(if $(shell sh update_build_info.sh $(protect $(HOLDIR))),build_info.txt,$(warning update_build_info.sh failed so build_info.txt was not refreshed))

EXTRA_CLEANS = cakeml-heap build_info.txt

ifdef POLY
all: cakeml-heap

cakeml-heap: preamble.uo
	$(HOLDIR)/bin/hol buildheap -o $@ $<
endif
